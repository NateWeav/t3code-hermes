         register_task_env_overrides(task_id, {"cwd": _translate_acp_cwd(cwd)})
     except Exception:
         logger.debug("Failed to register ACP task cwd override", exc_info=True)
 
 
+def _resolve_tool_cwd(cwd: str) -> str:
+    """Resolve the workspace seen by Hermes tools for this ACP process."""
+    terminal_backend = (os.getenv("TERMINAL_ENV") or "local").strip().lower()
+    if terminal_backend == "ssh":
+        configured_remote_cwd = (os.getenv("TERMINAL_CWD") or "").strip()
+        if configured_remote_cwd:
+            return configured_remote_cwd
+    return cwd
+
