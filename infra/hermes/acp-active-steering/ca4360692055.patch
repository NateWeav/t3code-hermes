diff --git a/tests/acp_adapter/test_gateway_active_steer.py b/tests/acp_adapter/test_gateway_active_steer.py
new file mode 100644
index 0000000000..4b4a2010dc
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_active_steer.py
@@ -0,0 +1,106 @@
+"""``_hermes/steer``: a steer sent while this editor's prompt runs reaches that turn, even one that
+makes no tool call, and nothing else ever runs it.
+
+Real gateway daemon, real ``hermes acp`` stdio process (``acp_adapter.entry``, the ``GatewayACPAgent``
+viewer), loopback model. The steer overtakes its prompt's ack and claim; the turn answers its prompt,
+then the steer, inside the one ``session/prompt``. A finished turn closed its agent's steer intake, so
+the steered turn is the session's second: its claim must open intake again. A steer once the turn has
+ended is refused, never queued as a prompt.
+"""
+import asyncio
+from http.server import BaseHTTPRequestHandler
+import json
+import threading
+
+import pytest
+
+from tests.acp_adapter.test_gateway_sessions import editor
+
+
+class SteerPeer(BaseHTTPRequestHandler):
+    """Holds the answer to ``HOLD_FOR_STEER`` until the test releases it; answers ``SAW_STEER`` to a
+    request whose newest user row carries the steer."""
+
+    def log_message(self, *args):
+        pass
+
+    def do_GET(self):
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps({"data": [{"id": "local-wire-stub", "object": "model"}]}).encode())
+
+    def do_POST(self):
+        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+        messages = request.get("messages") or []
+        last = json.dumps(next((m.get("content") for m in reversed(messages) if m.get("role") == "user"), ""))
+        if "STEER_NOTE" in last:
+            reply = "SAW_STEER"
+        elif "HOLD_FOR_STEER" in last:
+            self.server.held.set()
+            assert self.server.release.wait(15), "the test never released the held answer"
+            reply = "FIRST_ANSWER"
+        else:
+            reply = "WARM_ANSWER"
+        if messages:
+            self.server.requests.append(request)
+        base = {"id": "chatcmpl-steer", "model": "local-wire-stub", "created": 1}
+        self.send_response(200)
+        self.send_header("Content-Type", "text/event-stream" if request.get("stream") else "application/json")
+        self.end_headers()
+        if not request.get("stream"):
+            self.wfile.write(json.dumps({**base, "object": "chat.completion", "choices": [
+                {"index": 0, "message": {"role": "assistant", "content": reply}, "finish_reason": "stop"}],
+                "usage": {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}}).encode())
+            return
+        for delta, finish in [({"role": "assistant", "content": reply}, None), ({}, "stop")]:
+            chunk = {**base, "object": "chat.completion.chunk", "choices": [
+                {"index": 0, "delta": delta, "finish_reason": finish}]}
+            self.wfile.write(("data: " + json.dumps(chunk) + "\n\n").encode())
+            self.wfile.flush()
+        self.wfile.write(b"data: [DONE]\n\n")
+
+
+def _reply_text(frames):
+    return "".join(f["params"]["update"]["content"]["text"] for f in frames
+                   if f.get("method") == "session/update"
+                   and f["params"]["update"].get("sessionUpdate") == "agent_message_chunk")
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_a_steer_reaches_the_running_turn_without_a_tool_call(daemon, tmp_path, model_peer):
+    model_peer.RequestHandlerClass = SteerPeer
+    model_peer.held, model_peer.release = threading.Event(), threading.Event()
+    async with editor(daemon, tmp_path) as acp:
+        init = await acp.rpc("initialize", protocolVersion=1, clientCapabilities={})
+        assert init["result"]["agentCapabilities"]["_meta"]["hermes"]["steer"] is True, init
+        sid = (await acp.rpc("session/new", cwd=str(tmp_path), mcpServers=[]))["result"]["sessionId"]
+        warm = await acp.rpc("session/prompt", sessionId=sid, prompt=[{"type": "text", "text": "Warm up"}])
+        assert warm.get("result", {}).get("stopReason") == "end_turn", warm
+
+        turn = asyncio.create_task(acp.rpc("session/prompt", sessionId=sid,
+                                           prompt=[{"type": "text", "text": "HOLD_FOR_STEER"}]))
+        await asyncio.sleep(0)  # the prompt's request is written first; the steer follows it at once
+        steer = await acp.rpc("_hermes/steer", sessionId=sid, text="STEER_NOTE: answer SAW_STEER")
+        assert steer.get("result") == {"steered": True}, steer
+        assert not turn.done(), turn.result()
+        model_peer.release.set()
+        reply = await asyncio.wait_for(turn, 40)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+
+        late = await acp.rpc("_hermes/steer", sessionId=sid, text="STEER_NOTE: too late")
+        assert late.get("result") == {"steered": False}, late
+
+    assert model_peer.held.is_set()
+    turns = [request["messages"] for request in model_peer.requests]
+    # One model call per answer: the warm-up, the held answer, the steer's answer. The late steer ran nothing.
+    assert len(turns) == 3, [m[-1] for m in turns]
+    *_, held, steered = turns
+    assert "STEER_NOTE" not in json.dumps(held)
+    answered, steer_row = steered[-2:]
+    assert answered["role"] == "assistant" and answered["content"] == "FIRST_ANSWER", steered[-3:]
+    assert steer_row["role"] == "user" and "STEER_NOTE: answer SAW_STEER" in steer_row["content"], steer_row
+    text = _reply_text(acp.frames)
+    assert text.count("FIRST_ANSWER") == 1 and text.count("SAW_STEER") == 1, text
+    assert "Steer queued" not in text, text
