+"""An ACP editor viewing a gateway session sees that session's background processes run and exit,
+and its Stop ends the one still running."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+from tests.gateway.fixtures.local_recovery_probe import child_env
+
+
+def test_acp_viewer_reports_real_background_processes_and_stops_one(tmp_path):
+    root = Path(__file__).resolve().parents[2]
+    home, user = tmp_path / 'state', tmp_path / 'user'
+    home.mkdir()
+    user.mkdir()
+    env = child_env()
+    env.update(HOME=str(user), USERPROFILE=str(user), HERMES_HOME=str(home),
+               PYTHONPATH=str(root), PYTHONUNBUFFERED='1')
+    result = subprocess.run([sys.executable, str(root / 'tests/gateway/fixtures/acp_background_process_peer.py')],
+                            cwd=root, env=env, capture_output=True, text=True, timeout=90, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    receipt = json.loads((home / 'receipt.json').read_text())
+    by_call = {call: [r for r in receipt['reports'] if r['toolCallId'] == call] for call in ('call_1', 'call_2')}
+    assert all(r['method'] == 'hermes/process' for r in receipt['reports']), receipt
+    running, exited = by_call['call_1']
+    assert (running['status'], exited['status'], exited['exitCode'], exited['reason']) == \
+        ('running', 'exited', 3, 'exited'), receipt
+    assert exited['processId'] == running['processId']
+    assert exited['at_s'] >= 1.5, 'exited is reported after the process ends, not when it starts'
+    # The second process outlived the first and ran until the editor's Stop killed it.
+    assert receipt['stopped_before_stop'] is False and receipt['all_exited'] is True, receipt
+    running, stopped = by_call['call_2']
+    assert (running['status'], stopped['status'], stopped['reason']) == ('running', 'exited', 'killed'), receipt
+    assert stopped['at_s'] >= exited['at_s']
