new file mode 100644
index 0000000000..d08b1109f6
--- /dev/null
+++ b/acp_adapter/gateway_background.py
@@ -0,0 +1,171 @@
+"""Background processes of a gateway session, reported to ACP editors as ``_hermes/process``.
+
+``hermes acp`` views the gateway, whose daemon owns the process registry. An editor therefore sees a
+background ``terminal`` call complete the moment its process starts and hears nothing when the process
+ends, so it shows the work as done while it still runs. This reads the session's ``process.list`` (what
+Desktop's status stack polls) for each process a ``terminal`` call started and reports it, keyed by the
+launching ``toolCallId``: ``running`` once the gateway lists it, then ``exited`` with ``exitCode`` and
+``reason``. ``reason`` is ``lost`` when the gateway can no longer say.
+
+The gateway still wakes the session itself when a ``notify_on_complete`` process ends, so this adds
+liveness, not delivery. Editors that do not know the method ignore it, as ACP requires.
+
+An editor's Stop is the ``_hermes/process_stop`` notification: it kills the processes reported for
+that session (``process.kill``, Desktop's per-process Stop), and each exit is then reported as any
+other, which is the editor's confirmation.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+
+from hermes_cli.gateway_client import GatewayClientError, GatewayRPCError
+
+logger = logging.getLogger(__name__)
+
+# The SDK sends an extension method with a leading underscore: ``_hermes/process``.
+PROCESS_METHOD = "hermes/process"
+STOP_METHOD = "hermes/process_stop"
+POLL_SECONDS = 5.0
+# Reads in a row the transport may lose before the session's processes count as lost.
+MAX_MISSED_READS = 3
+
+
+def started_process_id(tool_name, result):
+    """The process id a successful background ``terminal`` result carries, else None."""
+    if tool_name != "terminal" or not isinstance(result, str):
+        return None
+    from acp_adapter.tools import _json_loads_maybe
+    data = _json_loads_maybe(result)
+    if not isinstance(data, dict) or data.get("error") or data.get("output") != "Background process started":
+        return None
+    proc_id = data.get("session_id")
+    return proc_id if isinstance(proc_id, str) and proc_id else None
+
+
+class _Watch:
+    """One session's tracked processes: ``{process id: report}``, plus the task that reads them."""
+
+    def __init__(self):
+        self.tracked, self.announced = {}, set()
+        self.wake = asyncio.Event()
+
+
+def _watches(agent):
+    # Kept off ``GatewayACPAgent.__init__``, so this module is the whole feature.
+    return agent.__dict__.setdefault("_process_watches", {})
+
+
+def observe_process_frame(agent, kind, sid, payload):
+    """Every projected frame passes here. A ``tool.complete`` that started a background process begins
+    tracking it; a turn starting re-reads at once, since the gateway starts one when a process it was
+    asked to notify about ends."""
+    watches = _watches(agent)
+    if kind == "message.start":
+        if sid in watches:
+            watches[sid].wake.set()
+        return
+    if kind != "tool.complete" or payload.get("is_error") is True:
+        return
+    call_id = payload.get("tool_call_id")
+    # In-process turns publish ``tool_name``; managed workers publish ``name``.
+    published = payload.get("tool_name") or payload.get("name")
+    tool_name, args, _ = agent._tool_args.get((sid, call_id), (published, {}, None))
+    proc_id = started_process_id(tool_name, payload.get("result"))
+    if proc_id is None:
+        return
+    command = args.get("command") if isinstance(args, dict) else None
+    watch = watches.get(sid)
+    if watch is None:
+        watch = watches[sid] = _Watch()
+        task = asyncio.get_running_loop().create_task(_watch(agent, sid, watch))
+        # Shutdown cancels and awaits ``_background`` (``GatewayACPAgent.aclose``).
+        agent._background.add(task)
+        task.add_done_callback(agent._background.discard)
+    watch.tracked[proc_id] = {"toolCallId": call_id, "processId": proc_id,
+                              "command": command if isinstance(command, str) else ""}
+    watch.wake.set()
+
+
+async def _watch(agent, sid, watch):
+    missed = 0
+    try:
+        while watch.tracked:
+            watch.wake.clear()
+            # A process tracked while the read is in flight may not be in its reply: next read.
+            asked = list(watch.tracked)
+            try:
+                gateway = agent._gateway
+                if gateway is None:
+                    # Never reconnect from here: that can start a gateway daemon for a status read.
+                    raise ConnectionError("gateway not connected")
+                listed = await gateway.rpc("process.list", session_id=sid)
+                rows = {row.get("session_id"): row for row in (listed or {}).get("processes", [])}
+                missed = 0
+            except GatewayRPCError:
+                # The owner refused: the session is gone, or its turns run in a managed worker whose
+                # registry the daemon cannot read. Nothing here can learn how these processes end.
+                rows = {}
+            except Exception:  # health: allow BLE001 -- a status read must never fail the viewer
+                missed += 1
+                rows = {} if missed >= MAX_MISSED_READS else None
+            if rows is not None:
+                await _report(agent, sid, watch, rows, asked)
+            if watch.tracked:
+                try:
+                    await asyncio.wait_for(watch.wake.wait(), POLL_SECONDS)
+                except asyncio.TimeoutError:
+                    pass
+    finally:
+        _watches(agent).pop(sid, None)
+
+
+async def _report(agent, sid, watch, rows, asked):
+    for proc_id in asked:
+        report = watch.tracked.get(proc_id)
+        if report is None:
+            continue
+        row = rows.get(proc_id)
+        running = row is not None and row.get("status") == "running"
+        if running and proc_id in watch.announced:
+            continue
+        params = {"sessionId": agent._editor_id(sid), **report}
+        if proc_id not in watch.announced:
+            if row is None:
+                # Never listed, so never reported: there is nothing for the editor to end.
+                del watch.tracked[proc_id]
+                continue
+            watch.announced.add(proc_id)
+            await _notify(agent, {**params, "status": "running"})
+            if running:
+                continue
+        del watch.tracked[proc_id]
+        watch.announced.discard(proc_id)
+        if row is None:
+            await _notify(agent, {**params, "status": "exited", "reason": "lost"})
+        else:
+            await _notify(agent, {**params, "status": "exited", "exitCode": row.get("exit_code"),
+                                  "reason": row.get("completion_reason") or "exited"})
+
+
+async def _notify(agent, params):
+    if agent._conn:
+        await agent._conn.ext_notification(PROCESS_METHOD, params)
+
+
+async def stop_reported_processes(agent, method, params):
+    """``_hermes/process_stop`` for ``params["sessionId"]``: kill what that session is tracked running.
+    A kill the owner refuses is not reported here; the next read says what became of the process."""
+    if method != STOP_METHOD or not isinstance(params, dict):
+        return
+    sid = agent._aliases.get(params.get("sessionId"), params.get("sessionId"))
+    watch = _watches(agent).get(sid)
+    gateway = agent._gateway
+    if watch is None or gateway is None:
+        return
+    for proc_id in list(watch.tracked):
+        try:
+            await gateway.rpc("process.kill", session_id=sid, process_id=proc_id)
+        except GatewayClientError:
+            logger.debug("ACP process stop refused for %s", proc_id, exc_info=True)
+    watch.wake.set()
