+@pytest.mark.asyncio
+@pytest.mark.parametrize('source, remote_cwd, expected', [
+    ('acp', '/srv/app', '/srv/app'),
+    ('acp', None, 'moved'),
+    ('cli', '/srv/app', 'moved'),
+])
+async def test_an_editor_move_keeps_an_ssh_backends_configured_remote_cwd(
+        tmp_path, monkeypatch, source, remote_cwd, expected):
+    """An ACP editor names a folder on the gateway host. An ssh backend configured with its own ``terminal.cwd``
+    keeps that remote directory through the move and the resume refresh that follows; the policy cwd still moves."""
+    home = _home(monkeypatch)
+    remote = 'terminal: {backend: ssh, ssh_host: box.invalid, ssh_user: me%s}\n' % (
+        f', cwd: {remote_cwd}' if remote_cwd else '')
+    (home / 'config.yaml').write_text(BEFORE.replace('terminal: {backend: local}\n', remote))
+    moved = tmp_path / 'project'
+    moved.mkdir()
+    store, authority = await _owner_authority(home)
+    owner = _connect(authority)
+    later = _connect(authority)
+    try:
+        sid = (await _call(owner, 'session.create', request_id='w', source=source, cwd=str(tmp_path)))['session_id']
+        await _mutate(owner, store, sid, 'move', 'workspace', {'cwd': str(moved)})
+        policy = _policy(authority, sid)
+        assert (policy.cwd, json.loads(policy.terminal_json).get('TERMINAL_CWD')) == (
+            str(moved), str(moved) if expected == 'moved' else expected)
+        (home / 'config.yaml').write_text(AFTER.replace('terminal: {backend: docker}\n', remote))
+        await _call(later, 'session.resume', session_id=sid)
+        policy = _policy(authority, sid)
+        assert policy.max_turns == 7  # the refresh ran
+        terminal = json.loads(policy.terminal_json)
+        assert (terminal['TERMINAL_ENV'], policy.cwd, terminal.get('TERMINAL_CWD')) == (
+            'ssh', str(moved), str(moved) if expected == 'moved' else expected)
+    finally:
+        for connection in (owner, later):
+            await connection.close()
+        store.close_all_db_handles()
+
+
