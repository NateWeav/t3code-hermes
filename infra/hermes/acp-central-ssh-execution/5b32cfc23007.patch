diff --git a/tests/acp_adapter/test_gateway_ssh_workspace.py b/tests/acp_adapter/test_gateway_ssh_workspace.py
new file mode 100644
index 0000000000..78c04fa603
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_ssh_workspace.py
@@ -0,0 +1,39 @@
+"""An editor's folder never retargets an ssh backend's configured remote cwd (real ACP stdio, real gateway).
+
+The editor names a folder on the gateway's host; tools on an ssh backend run on the target, where that
+path need not exist. ``session/load`` from another folder moves the session's own cwd, not the backend's.
+"""
+import json
+import sqlite3
+
+import pytest
+
+from hermes_state_local import POLICY_PREFIX
+from tests.acp_adapter.test_gateway_sessions import editor
+
+_SSH = {'terminal': {'backend': 'ssh', 'ssh_host': 'box.invalid', 'ssh_user': 'me', 'cwd': '/srv/app'}}
+
+
+def _frozen(home, sid):
+    """``(cwd, TERMINAL_CWD)`` of the session's committed policy."""
+    with sqlite3.connect(f'file:{home / "state.db"}?mode=ro', uri=True) as conn:
+        (value,) = conn.execute('SELECT value FROM state_meta WHERE key=?', (POLICY_PREFIX + sid,)).fetchone()
+    policy = json.loads(value)['policy']
+    return policy['cwd'], json.loads(policy['terminal_json']).get('TERMINAL_CWD')
+
+
+@pytest.mark.platforms('linux')
+@pytest.mark.parametrize('daemon', [_SSH], indirect=True)
+@pytest.mark.asyncio
+async def test_loading_a_session_from_another_folder_keeps_the_ssh_remote_cwd(daemon, tmp_path, model_peer):
+    first, second = tmp_path / 'first', tmp_path / 'second'
+    first.mkdir()
+    second.mkdir()
+    async with editor(daemon, tmp_path) as acp:
+        await acp.rpc('initialize', protocolVersion=1, clientCapabilities={})
+        created = await acp.rpc('session/new', cwd=str(first), mcpServers=[])
+        sid = created['result']['sessionId']
+        assert _frozen(daemon[0], sid) == (str(first), '/srv/app')
+        loaded = await acp.rpc('session/load', cwd=str(second), sessionId=sid, mcpServers=[])
+        assert 'result' in loaded, loaded
+        assert _frozen(daemon[0], sid) == (str(second), '/srv/app')
