+# An ACP editor that asked to approve every shell command (``editor.command_approval``), bound for its
+# session's turns by ``gateway.session_local_editor.editor_scope``.
+_editor_command_approval: contextvars.ContextVar[bool] = contextvars.ContextVar(
+    "editor_command_approval", default=False)
+
+
+def set_editor_command_approval(enabled: bool) -> contextvars.Token:
+    return _editor_command_approval.set(enabled)
+
+
+def reset_editor_command_approval(token: contextvars.Token) -> None:
+    _editor_command_approval.reset(token)
+
+
+def editor_asks_before_commands() -> bool:
+    return _editor_command_approval.get()
+
+
 def _is_interactive_cli() -> bool:
