+def _argument_diff(tool_name, args):
+    """The change an edit's own arguments describe (a ``write_file``, or a ``patch`` replace), as the
+    in-process server showed for an edit its mode ran unasked; the owner, not the viewer, reads the file."""
+    from acp_adapter.edit_approval import EditProposal
+    path = args.get("path")
+    if not isinstance(path, str) or not path:
+        return None
+    if tool_name == "write_file" and isinstance(args.get("content"), str):
+        return EditProposal(tool_name, path, None, args["content"], args)
+    if tool_name == "patch" and args.get("mode", "replace") == "replace" and isinstance(args.get("old_string"), str) \
+            and isinstance(args.get("new_string"), str):
+        return EditProposal(tool_name, path, args["old_string"] or None, args["new_string"], args)
+    return None
+
+
+def _start_builder(mode):
+    """``build_tool_start`` for a session in *mode*: under Accept Edits or Don't Ask no approval card may
+    carry an edit's diff, so its start does."""
+    from acp_adapter.tools import build_tool_start
+    if mode == "default":
+        return build_tool_start
+    return lambda call_id, tool_name, args: build_tool_start(
+        call_id, tool_name, args, edit_diff=_argument_diff(tool_name, args))
+
