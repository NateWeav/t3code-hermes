+++ b/tests/acp_adapter/test_gateway_command_approval.py
@@ -0,0 +1,179 @@
+"""An ACP editor that asks to approve every shell command, and an edit's diff when nothing asks, over a
+real daemon and ``hermes acp``."""
+import asyncio
+from contextlib import suppress
+from http.server import BaseHTTPRequestHandler
+import json
+
+import pytest
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from tests.acp_adapter.test_gateway_sessions import editor
+from tests.waiting import async_wait_until
+
+
+class ToolPeer(BaseHTTPRequestHandler):
+    """Calls ``server.tool`` (name, arguments) once per user turn, then finishes."""
+
+    def log_message(self, *args):
+        pass
+
+    def do_POST(self):
+        request = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+        messages = request.get('messages', [])
+        last_user = max((i for i, m in enumerate(messages) if m['role'] == 'user'), default=-1)
+        tool = not any(m['role'] == 'tool' for m in messages[last_user + 1:])
+        message = {'role': 'assistant', 'content': 'COMMAND_FINISHED'}
+        if tool:
+            message = {'role': 'assistant', 'content': None, 'tool_calls': [{
+                'id': 'owned-command', 'type': 'function', 'function': {
+                    'name': self.server.tool[0], 'arguments': json.dumps(self.server.tool[1])}}]}
+        self.send_response(200)
+        self.send_header('Content-Type', 'text/event-stream' if request.get('stream') else 'application/json')
+        self.end_headers()
+        if request.get('stream'):
+            if tool:
+                message['tool_calls'][0]['index'] = 0
+            for delta, finish in [(message, None), ({}, 'tool_calls' if tool else 'stop')]:
+                self.wfile.write(('data: ' + json.dumps({'id': 'command', 'object': 'chat.completion.chunk',
+                    'created': 1, 'model': 'fixture', 'choices': [{'index': 0, 'delta': delta,
+                    'finish_reason': finish}]}) + '\n\n').encode())
+            self.wfile.write(b'data: [DONE]\n\n')
+        else:
+            self.wfile.write(json.dumps({'id': 'command', 'object': 'chat.completion', 'created': 1,
+                'model': 'fixture', 'choices': [{'index': 0, 'message': message,
+                'finish_reason': 'tool_calls' if tool else 'stop'}]}).encode())
+        self.wfile.flush()
+
+
+def _permissions(acp):
+    return [f for f in acp.frames if f.get('method') == 'session/request_permission']
+
+
+async def _answer(acp, permission, option_id):
+    acp.process.stdin.write(json.dumps({'jsonrpc': '2.0', 'id': permission['id'], 'result': {
+        'outcome': {'outcome': 'selected', 'optionId': option_id}}}).encode() + b'\n')
+    await acp.process.stdin.drain()
+
+
+async def _prompt(acp, sid, text):
+    return await acp.rpc('session/prompt', sessionId=sid, prompt=[{'type': 'text', 'text': text}])
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_editor_that_asked_approves_every_command_until_dont_ask(daemon, tmp_path, model_peer):
+    target = tmp_path / 'owned.txt'
+    command = f"printf approved > {target}"
+    model_peer.tool = ('terminal', {'command': command})
+    model_peer.RequestHandlerClass = ToolPeer
+    async with editor(daemon, tmp_path) as acp:
+        await acp.rpc('initialize', protocolVersion=1, clientCapabilities={'_meta': {'command_approval': True}})
+        created = await acp.rpc('session/new', cwd=str(tmp_path), mcpServers=[])
+        sid = created['result']['sessionId']
+        task = asyncio.create_task(_prompt(acp, sid, 'Write the owned file'))
+        try:
+            await async_wait_until(lambda: _permissions(acp), timeout=20, what='the command permission request')
+            permission = _permissions(acp)[0]
+            call = permission['params']['toolCall']
+            assert call['kind'] == 'execute', permission
+            assert call['rawInput']['command'] == command
+            # "Allow for session" covers this one command; no grant persists to config.yaml.
+            options = [o['optionId'] for o in permission['params']['options']]
+            assert 'allow_session' in options and 'allow_always' not in options, options
+            assert not target.exists() and not task.done()
+            await _answer(acp, permission, 'allow_once')
+            assert (await task)['result']['stopReason'] == 'end_turn'
+            assert target.read_text() == 'approved'
+        finally:
+            task.cancel()
+            with suppress(asyncio.CancelledError):
+                await task
+
+        # A denied command does not run.
+        target.unlink()
+        task = asyncio.create_task(_prompt(acp, sid, 'Write it again'))
+        try:
+            await async_wait_until(lambda: len(_permissions(acp)) == 2, timeout=20, what='the second request')
+            await _answer(acp, _permissions(acp)[1], 'deny')
+            assert (await task)['result']['stopReason'] == 'end_turn'
+            assert not target.exists()
+        finally:
+            task.cancel()
+            with suppress(asyncio.CancelledError):
+                await task
+
+        # Don't Ask runs its edits unasked, and its commands too.
+        assert 'result' in await acp.rpc('session/set_mode', sessionId=sid, modeId='dont_ask')
+        turn = await _prompt(acp, sid, 'Write it once more')
+        assert turn['result']['stopReason'] == 'end_turn', turn
+        assert target.read_text() == 'approved'
+        assert len(_permissions(acp)) == 2
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_editor_that_did_not_ask_keeps_the_dangerous_command_rule(daemon, tmp_path, model_peer):
+    target = tmp_path / 'owned.txt'
+    model_peer.tool = ('terminal', {'command': f"printf unasked > {target}"})
+    model_peer.RequestHandlerClass = ToolPeer
+    async with editor(daemon, tmp_path) as acp:
+        await acp.rpc('initialize', protocolVersion=1, clientCapabilities={})
+        sid = (await acp.rpc('session/new', cwd=str(tmp_path), mcpServers=[]))['result']['sessionId']
+        turn = await _prompt(acp, sid, 'Write the owned file')
+        assert turn['result']['stopReason'] == 'end_turn', turn
+        assert target.read_text() == 'unasked'
+        assert not _permissions(acp)
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_an_edit_that_runs_unasked_shows_its_diff_when_it_starts(daemon, tmp_path, model_peer):
+    """Default asks and its card carries the diff; Accept Edits runs a workspace write unasked, so the
+    write's own start does."""
+    model_peer.RequestHandlerClass = ToolPeer
+    async with editor(daemon, tmp_path) as acp:
+        await acp.rpc('initialize', protocolVersion=1, clientCapabilities={})
+        sid = (await acp.rpc('session/new', cwd=str(tmp_path), mcpServers=[]))['result']['sessionId']
+        assert 'result' in await acp.rpc('session/set_mode', sessionId=sid, modeId='accept_edits')
+        target = tmp_path / 'unasked.txt'
+        model_peer.tool = ('write_file', {'path': str(target), 'content': 'unasked edit'})
+        turn = await _prompt(acp, sid, 'Write the file')
+        assert turn['result']['stopReason'] == 'end_turn', turn
+        assert target.read_text() == 'unasked edit'
+        assert not _permissions(acp)
+        start = next(f['params']['update'] for f in acp.frames if f.get('method') == 'session/update'
+                     and f['params']['update'].get('sessionUpdate') == 'tool_call')
+        assert start['kind'] == 'edit'
+        assert start['content'] == [{'type': 'diff', 'path': str(target), 'newText': 'unasked edit'}], start
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(('meta', 'capabilities', 'asks'), [
+    ({'command_approval': True}, ['acp-editor-policy-v1', 'acp-command-approval-v1'], True),
+    ({}, ['acp-editor-policy-v1', 'acp-command-approval-v1'], False),
+    # An owner from before the key would refuse the whole session; it keeps Hermes's own rule.
+    ({'command_approval': True}, ['acp-editor-policy-v1'], False),
+])
+async def test_viewer_asks_the_owner_only_for_an_editor_that_asked(tmp_path, meta, capabilities, asks):
+    created = []
+
+    async def rpc(method, **params):
+        if method == 'runtime.describe':
+            return {'session_create': {'sources': ['acp']}, 'capabilities': capabilities}
+        if method == 'config.set':
+            return {'key': params['key'], 'value': params['value'], 'scope': 'session'}
+        assert method == 'session.create', method
+        created.append(params)
+        return {'session_id': 's', 'info': {'cwd': params['cwd']}}
+
+    agent = GatewayACPAgent()
+    agent._gateway = AsyncMock()
+    agent._gateway.rpc.side_effect = rpc
+    agent._session_fields = AsyncMock(return_value={})
+    await agent.initialize(protocol_version=1, client_capabilities=SimpleNamespace(field_meta=meta))
+    await agent.new_session(cwd=str(tmp_path))
+    assert ('command_approval' in created[0]['editor']) is asks
