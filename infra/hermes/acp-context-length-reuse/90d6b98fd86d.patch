--- /dev/null
+++ b/tests/gateway/test_context_probe_memo_gateway.py
@@ -0,0 +1,113 @@
+"""The gateway resolves a custom endpoint's context window once per process, not once per agent build.
+
+Every session.create, warm-up and turn resolves the window through ``_resolve_gateway_model_context``.
+Without ``model.context_length``, each resolution probed the endpoint again (``/models``, the local
+server waterfall, Ollama ``/api/show``), and an endpoint that stalls held each new session for the
+probes' timeouts. These tests run that resolver against a real HTTP endpoint that publishes no window.
+"""
+from __future__ import annotations
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import gateway.run as gateway_run
+
+MODEL = "mystery-model"  # in no catalog: the window is the generic default, labelled as one
+
+
+class _Endpoint:
+    """OpenAI-compatible server that lists the model but publishes no context length."""
+
+    def __init__(self):
+        self.requests: list[str] = []
+        self.status = 200
+        endpoint = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def _answer(self):
+                endpoint.requests.append(f"{self.command} {self.path}")
+                length = int(self.headers.get("Content-Length") or 0)
+                if length:
+                    self.rfile.read(length)
+                if endpoint.status != 200:
+                    code, body = endpoint.status, b"{}"
+                elif self.command == "GET" and self.path == "/v1/models":
+                    code, body = 200, json.dumps({"object": "list", "data": [{"id": MODEL, "object": "model"}]}).encode()
+                else:
+                    code, body = 404, b'{"error":"not found"}'
+                self.send_response(code)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            do_GET = do_POST = _answer
+
+            def log_message(self, *_args):
+                pass
+
+        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.url = f"http://127.0.0.1:{self.server.server_address[1]}/v1"
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+
+    def take(self) -> list[str]:
+        taken, self.requests[:] = list(self.requests), []
+        return taken
+
+
+@pytest.fixture
+def endpoint(monkeypatch):
+    server = _Endpoint()
+    server.thread.start()
+    config = {"model": {"default": MODEL, "provider": "custom", "base_url": server.url}}
+    monkeypatch.setattr(gateway_run, "_load_gateway_config", lambda: config)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs",
+                        lambda: {"provider": "custom", "base_url": server.url, "api_key": "sk-test"})
+    server.config = config
+    try:
+        yield server
+    finally:
+        server.server.shutdown()
+        server.server.server_close()
+
+
+def _resolve():
+    resolved = gateway_run._resolve_gateway_model_context()
+    return resolved.context_length, resolved.context_source
+
+
+def test_a_new_session_reuses_the_window_the_last_one_probed(endpoint):
+    from agent.model_metadata import DEFAULT_FALLBACK_CONTEXT
+
+    assert _resolve() == (DEFAULT_FALLBACK_CONTEXT, "default")
+    assert endpoint.take()  # the first resolution asks the endpoint
+    assert _resolve() == (DEFAULT_FALLBACK_CONTEXT, "default")  # still labelled as a default
+    assert endpoint.take() == []
+
+
+def test_a_failed_probe_is_not_remembered(endpoint):
+    endpoint.status = 503
+    _resolve()
+    assert endpoint.take()
+    endpoint.status = 200
+    _resolve()
+    assert endpoint.take()  # asked again: the last answer came from a failure
+
+
+def test_a_configured_context_length_still_wins(endpoint):
+    _resolve()
+    endpoint.take()
+    endpoint.config["model"]["context_length"] = 64_000
+    assert _resolve() == (64_000, "config")
+    assert endpoint.take() == []
+
+
+def test_a_persisted_window_replaces_the_remembered_one(endpoint):
+    from agent.model_metadata import DEFAULT_FALLBACK_CONTEXT, save_context_length
+
+    assert _resolve()[0] == DEFAULT_FALLBACK_CONTEXT
+    save_context_length(MODEL, endpoint.url, 100_000)  # e.g. an overflow error taught a smaller window
+    assert _resolve() == (100_000, "detected")
