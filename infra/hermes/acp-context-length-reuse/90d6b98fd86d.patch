new file mode 100644
index 0000000000..af3fbfbf8c
--- /dev/null
+++ b/agent/model_metadata_probe_memo.py
@@ -0,0 +1,116 @@
+"""Process-lifetime memo of context windows resolved by probing a custom endpoint.
+
+Without ``model.context_length``, every agent build asks a custom endpoint for its window
+(``/models``, the local-server waterfall, Ollama ``/api/show``). An endpoint that publishes none
+gets the same catalog or default answer on every build, and one that stalls holds each build for the
+probes' timeouts. A resolution whose probes all got an answer is remembered for the process. One
+where any probe failed (transport error, timeout, 5xx, 429) is not, so the next build asks again.
+Persisting a window (an overflow step-down, a probe that found one) forgets that endpoint's entries.
+"""
+from __future__ import annotations
+
+import contextvars
+import threading
+from contextlib import contextmanager
+from typing import Callable, Iterator
+
+from agent.context_default_record import context_defaulted, mark_context_defaulted
+
+# Set while a probe runs under ``watch()``; failure sites flip it.
+_FAILED: contextvars.ContextVar[list | None] = contextvars.ContextVar("context_probe_failed", default=None)
+_REMEMBERED: dict[tuple, tuple[int, bool]] = {}  # key -> (window, resolved to a default)
+_LOCKS: dict[tuple, threading.Lock] = {}
+_GUARD = threading.Lock()
+# Keys of short-lived negative caches (no /models catalog, no server type) written after a failed probe:
+# a later hit on one is that same failure, not an answer.
+_FAILED_NEGATIVES: set[tuple] = set()
+_MAX_ENTRIES = 512
+
+
+def is_probe_failure(exc: BaseException) -> bool:
+    """A probe that got no answer. A 4xx (404, 401) is the endpoint answering."""
+    import httpx
+
+    from agent.deadline import DeadlineExpired
+    if isinstance(exc, httpx.HTTPStatusError):
+        return exc.response.status_code >= 500 or exc.response.status_code == 429
+    return isinstance(exc, (httpx.TransportError, DeadlineExpired))
+
+
+def note_probe_failure(exc: BaseException | None = None) -> bool:
+    """Count ``exc`` (or, with none, the caller's own verdict) against the running resolution."""
+    if exc is not None and not is_probe_failure(exc):
+        return False
+    flag = _FAILED.get()
+    if flag is not None:
+        flag[0] = True
+    return True
+
+
+def response_hook(failed: list | None = None) -> Callable:
+    """httpx response hook for probes that read a status instead of raising on it."""
+    def hook(response) -> None:
+        if (response.status_code >= 500 or response.status_code == 429) and note_probe_failure() and failed is not None:
+            failed[0] = True
+    return hook
+
+
+@contextmanager
+def watch() -> Iterator[list]:
+    """Collect failures of the probes run inside; they also count for any enclosing ``watch``."""
+    outer, flag = _FAILED.get(), [False]
+    token = _FAILED.set(flag)
+    try:
+        yield flag
+    finally:
+        _FAILED.reset(token)
+        if flag[0] and outer is not None:
+            outer[0] = True
+
+
+def record_negative(key: tuple, failed: bool) -> None:
+    with _GUARD:
+        if not failed:
+            _FAILED_NEGATIVES.discard(key)
+            return
+        if len(_FAILED_NEGATIVES) >= _MAX_ENTRIES:
+            _FAILED_NEGATIVES.clear()
+        _FAILED_NEGATIVES.add(key)
+
+
+def note_cached_negative(key: tuple) -> None:
+    if key in _FAILED_NEGATIVES:
+        note_probe_failure()
+
+
+def remember(key: tuple, resolve: Callable[[], int]) -> int:
+    """``resolve()`` once per key for the process, unless a probe in it failed.
+
+    Concurrent first lookups of one key wait for the one in flight instead of probing again.
+    """
+    hit = _REMEMBERED.get(key)
+    if hit is None:
+        with _GUARD:
+            lock = _LOCKS.setdefault(key, threading.Lock())
+        with lock:
+            hit = _REMEMBERED.get(key)
+            if hit is None:
+                with watch() as failed:
+                    window = resolve()
+                if not failed[0]:
+                    with _GUARD:
+                        if len(_REMEMBERED) >= _MAX_ENTRIES:
+                            _REMEMBERED.clear()
+                        _REMEMBERED[key] = (window, context_defaulted())
+                return window
+    if hit[1]:
+        mark_context_defaulted()
+    return hit[0]
+
+
+def forget(base_url: str) -> None:
+    """Drop every remembered window for ``base_url`` (keys end with the normalized URL's memo key)."""
+    url = (base_url or "").strip().rstrip("/")
+    with _GUARD:
+        for key in [k for k in _REMEMBERED if k[-2].rstrip("/") == url]:
+            del _REMEMBERED[key]
