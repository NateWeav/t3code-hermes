+++ b/tests/acp_adapter/test_gateway_delegation_progress.py
@@ -0,0 +1,449 @@
+"""Subagent progress reaches an editor through ``hermes acp``, which is a viewer of the gateway daemon.
+
+The owner publishes each child's ``subagent.*`` frame (``gateway/local_viewer_events.py``); the viewer projects it
+onto the parent ``delegate_task`` call. These tests run the owner's real publish path (child relay, turn callback,
+event stream, the descendant gate for background children) into the viewer ``HermesACPAgent()`` builds, with no
+session manager, which is what ``hermes acp`` runs.
+"""
+import asyncio
+import json
+import threading
+import weakref
+from concurrent.futures import Future
+from contextlib import asynccontextmanager
+from contextvars import Context
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+from acp.schema import ToolCallProgress, ToolCallStart
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from acp_adapter.server import HermesACPAgent
+from agent.tool_executor import _dispatch_authorized_once, _ManagedToolResult, _ToolCallRef
+from gateway.config import Platform
+from gateway.run_turn_runner import TurnRunner
+from gateway.session_authority import SessionAuthority
+from gateway.session_events import SessionEvents
+from tools import async_delegation as ad
+from tools.delegate_tool_dispatch import _dispatch_unit
+from tools.delegate_tool_progress import _build_child_progress_callback
+from tools.delegate_tool_registry import _register_subagent, _unregister_subagent
+from tools.process_registry import process_registry
+
+SID = "s"
+
+
+class _Agent:
+    """A parent or child agent: weakref-able, like the real ones."""
+
+
+class Owner:
+    """The session authority side of one local session: a real turn runner publishing into a real event stream.
+
+    ``viewers`` get every frame the stream delivers, in order, from any thread.
+    """
+
+    def __init__(self, loop, viewers):
+        self.stream = SessionEvents()
+        self.stream.execution = {"admission_id": "a1", "execution_generation": 1}
+        live = SimpleNamespace(tool_progress_mode=None, show_reasoning=False, event_stream=self.stream)
+        self.authority = SimpleNamespace(sessions={SID: live}, executing={SID: 1})
+        self.frames = []
+        self.sent = threading.Event()  # a child's terminal frame was delivered
+        self.stream.observers.add(self._observe)
+        self._loop, self._viewers = loop, viewers
+        self.parent = parent = _Agent()  # the agent loop's side, as far as one tool call needs it
+        parent._delegate_spinner = None
+        parent._tool_guardrails = SimpleNamespace(before_call=lambda *a: SimpleNamespace(allows_execution=True))
+        parent._checkpoint_mgr = SimpleNamespace(enabled=False)
+        parent._touch_activity = lambda _: None
+        parent.quiet_mode, parent.verbose_logging = True, False
+        turn = self.turn = object.__new__(TurnRunner)
+        turn._ctx = SimpleNamespace(
+            source=SimpleNamespace(platform=Platform.LOCAL, chat_id="chat"),
+            mute_notification_reply=False, scheduled_heartbeat=False,
+            streaming_tts_consumer_holder=[None], stream_consumer_holder=[None],
+            interim_assistant_messages_enabled=False, user_config={},
+            resolve_display_setting=lambda *a: None, _run_still_current=lambda: True,
+            _voice_ack_guild=[None], _native_slack_task_cards=False, progress_mode="all",
+            session_id=SID, progress_queue=None, _live_status_adapter=None, _live_status_mode="off",
+            log_queue=None, agent_holder=[self.parent],
+        )
+        turn._runner = SimpleNamespace(config=None, _delivery_adapter_for=lambda source: None)
+        turn._approval_owner = (self.authority, SID, 1)
+        turn._publish_execution = lambda kind, payload: SessionAuthority.publish_execution(
+            self.authority, SID, 1, kind, payload)
+        turn._publish_api_tool = lambda *a, **k: None
+        turn._schedule = lambda coro, _message: coro.close()
+        parent.tool_progress_callback = turn.progress_callback
+        parent.tool_start_callback = turn.combined_tool_start_callback
+
+    def _observe(self, frame):
+        self.frames.append(frame["params"])
+        if frame["params"]["type"] == "subagent.complete":
+            self.sent.set()
+        self._loop.call_soon_threadsafe(self._viewers.put_nowait, frame)
+
+    def end_turn(self):
+        """The spawning turn's running claim is gone: later frames are out of turn."""
+        self.authority.executing = {}
+
+    def child(self, index, goal, *, delegation_id="deleg_1", relay_context=None):
+        """A child and its relay, built the way ``_build_child`` builds them (on the delegate_task call's thread)."""
+        child = _Agent()
+        child._delegate_parent_ref = weakref.ref(self.parent)
+        subagent_id = child._subagent_id = f"sa-{index}-{delegation_id}"
+        child.record = {"subagent_id": subagent_id, "agent": child, "owner_agent_session_id": SID}
+        relay = _build_child_progress_callback(
+            index, goal, self.parent, 2, subagent_id=subagent_id, depth=0, model=f"test/model-{index}",
+            session_ref={"delegation_id": delegation_id, "session_id": f"child-session-{index}"})
+        child.tool_progress_callback = relay
+        child.model = f"test/model-{index}"
+        return child
+
+
+@asynccontextmanager
+async def editor_session():
+    """``hermes acp``'s agent attached to a session, its event pump running, and the owner publishing to it."""
+    agent = HermesACPAgent()  # acp_adapter/entry.py: no session manager, so the gateway viewer
+    assert type(agent) is GatewayACPAgent
+    updates = []
+
+    async def session_update(session_id, update, **kwargs):
+        updates.append(update)
+
+    agent._conn = SimpleNamespace(session_update=session_update)
+    agent._gateway = SimpleNamespace(events=asyncio.Queue())
+    agent._snapshots[SID] = {}
+    owner = Owner(asyncio.get_running_loop(), agent._gateway.events)
+    pump = asyncio.create_task(agent._events())
+
+    async def settle():
+        """Wait until the pump has projected every frame published so far (it handles a recovery in order)."""
+        done = asyncio.Event()
+
+        async def barrier(*_):
+            done.set()
+
+        agent._recover = barrier
+        asyncio.get_running_loop().call_soon_threadsafe(agent._gateway.events.put_nowait, ("barrier",))
+        await done.wait()
+
+    try:
+        yield agent, owner, updates, settle
+    finally:
+        pump.cancel()
+        await asyncio.gather(pump, return_exceptions=True)
+
+
+def progress(updates):
+    """The ``hermesDelegation`` snapshots the editor was sent, in order, with the call they belong to."""
+    return [(u.tool_call_id, u.status, u.raw_output["hermesDelegation"]) for u in updates
+            if isinstance(u, ToolCallProgress) and isinstance(u.raw_output, dict) and "hermesDelegation" in u.raw_output]
+
+
+def delegate_args(*goals):
+    return {"tasks": [{"goal": goal} for goal in goals]}
+
+
+@pytest.fixture(autouse=True)
+def registry_state():
+    ad._reset_for_tests()
+    while not process_registry.completion_queue.empty():
+        process_registry.completion_queue.get_nowait()
+    yield
+    ad._reset_for_tests()
