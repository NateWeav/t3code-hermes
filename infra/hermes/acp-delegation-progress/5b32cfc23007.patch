+class _ManualExecutor:
+    """The registry's pool: workers run only when a test says so (real Futures keep retirement balanced)."""
+
+    def __init__(self):
+        self.jobs = []
+
+    def submit(self, fn):
+        future = Future()
+        self.jobs.append((fn, future))
+        return future
+
+    def run(self, index):
+        fn, future = self.jobs[index]
+        try:
+            fn()
+        finally:
+            future.set_result(None)
+
+    def release(self):
+        for _, future in self.jobs:
+            if not future.done():
+                future.set_result(None)
+
