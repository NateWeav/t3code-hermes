@@ -0,0 +1,96 @@
+"""Live subagent progress for ``delegate_task`` on the gateway path.
+
+The owner publishes each child's ``subagent.*`` frame with ``parent_tool_call_id`` (``tools/delegate_tool_progress.py``
+stamps it, ``gateway/local_viewer_events.py`` publishes it). It is projected as a ``tool_call_update`` on that parent
+call carrying a bounded per-child snapshot in ``raw_output["hermesDelegation"]``. A frame whose parent call this
+viewer did not see start, or whose child is already owned by another call, is dropped: never matched by goal, index
+or order. Background children outlive the parent's ``tool.complete`` and the turn, so parents are retained.
+"""
+from __future__ import annotations
+
+import acp
+
+# Only these events and scalar fields cross the ACP boundary (no ``subagent.thinking``: a chain of thought).
+SUBAGENT_EVENTS = frozenset({
+    "subagent.spawn_requested", "subagent.start", "subagent.tool", "subagent.progress", "subagent.complete",
+})
+_TEXT_LIMITS = {
+    "goal": 2000, "model": 256, "status": 64, "summary": 2000,
+    "subagent_id": 256, "child_session_id": 256, "delegation_id": 256,
+}
+_COUNTS = ("task_index", "task_count", "depth", "tool_count", "input_tokens", "output_tokens", "reasoning_tokens")
+_MAX_PARENTS, _MAX_CHILDREN = 256, 128
+
+
+def _fields(payload: dict) -> dict:
+    fields = {}
+    for key, limit in _TEXT_LIMITS.items():
+        value = payload.get(key)
+        if isinstance(value, str):
+            # Never truncate routing identities into collisions.
+            if key.endswith("_id") and (not value or len(value) > limit):
+                continue
+            fields[key] = value[:limit]
+    for key in _COUNTS:
+        value = payload.get(key)
+        if type(value) is int and 0 <= value <= 2**31 - 1:
+            fields[key] = value
+    duration = payload.get("duration_seconds")
+    if type(duration) in (int, float) and 0 <= duration <= 1e12:
+        fields["duration_seconds"] = duration
+    return fields
+
+
+class DelegationProgress:
+    """The ``delegate_task`` calls this viewer saw start, and the children each one owns."""
+
+    def __init__(self):
+        self.parents = {}  # (session, tool_call_id) -> {"children": {child key: state}, "ids": {subagent_id}}
+        self.owners = {}  # (session, subagent_id) -> parent key
+
+    def start(self, sid: str, call_id: str) -> None:
+        self._forget((sid, call_id))
+        self.parents[(sid, call_id)] = {"children": {}, "ids": set()}
+        if len(self.parents) > _MAX_PARENTS:
+            self._forget(next(iter(self.parents)))
+
+    def _forget(self, key) -> None:
+        for subagent_id in self.parents.pop(key, {"ids": ()})["ids"]:
+            self.owners.pop((key[0], subagent_id), None)
+
+    def update(self, sid: str, event: str, payload: dict):
+        """The ``tool_call_update`` for one ``subagent.*`` frame, or None when it has no proven owner."""
+        call_id = payload.get("parent_tool_call_id")
+        key = (sid, call_id)
+        parent = self.parents.get(key) if isinstance(call_id, str) else None
+        fields = _fields(payload)
+        # A grandchild's task_index is local to its own batch; only T3's direct rows have an owner here.
+        if event not in SUBAGENT_EVENTS or parent is None or fields.get("depth", 0) or payload.get("parent_id"):
+            return None
+        subagent_id = fields.get("subagent_id")
+        if subagent_id is not None:
+            if self.owners.setdefault((sid, subagent_id), key) != key:
+                return None
+            parent["ids"].add(subagent_id)
+            child_key = ("child", subagent_id)
+        elif "delegation_id" in fields:
+            child_key = (fields["delegation_id"], fields.get("task_index", 0))
+        else:
+            child_key = ("index", fields.get("task_index", 0))
+        children = parent["children"]
+        if child_key not in children:
+            if len(children) >= _MAX_CHILDREN:
+                return None
+            children[child_key] = {"fields": {}}
+        child = children[child_key]
+        if child.get("complete"):
+            return None
+        child["complete"] = event == "subagent.complete"
+        child["fields"].update(fields)
+        snapshot = dict(child["fields"], event=event)
+        text = payload.get("text")
+        snapshot["text"] = text[:2000] if isinstance(text, str) else ""
+        tool = payload.get("tool_name")
+        if event == "subagent.tool" and isinstance(tool, str):
+            snapshot["tool"] = tool[:256]
+        return acp.update_tool_call(call_id, status="in_progress", raw_output={"hermesDelegation": snapshot})
