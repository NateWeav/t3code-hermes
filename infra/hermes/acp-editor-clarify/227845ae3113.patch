diff --git a/tests/acp_adapter/test_gateway_editor_clarify_toolset.py b/tests/acp_adapter/test_gateway_editor_clarify_toolset.py
new file mode 100644
index 0000000000..e50f1a6986
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_editor_clarify_toolset.py
@@ -0,0 +1,64 @@
+"""An ACP session offers clarify to an editor that can answer it as a form, and to no other.
+
+Real gateway daemon, real ``hermes acp`` stdio process (``acp_adapter.entry``, the ``GatewayACPAgent``
+viewer), loopback model that calls the real clarify tool and records the tools each request offered.
+``hermes-acp`` leaves clarify out; a session that an editor advertising ``elicitation.form`` creates
+gets it, and the editor's answer reaches the model. ``agent.disabled_toolsets: [clarify]`` still
+turns it off.
+"""
+import asyncio
+import io
+import json
+import time
+
+import pytest
+
+from tests.acp_adapter.test_gateway_sessions import editor
+from tests.gateway.fixtures.authority_clarify_peer import ModelPeer as ClarifyPeer
+
+
+class OfferRecordingPeer(ClarifyPeer):
+    def do_POST(self):
+        raw = self.rfile.read(int(self.headers['Content-Length']))
+        tools = json.loads(raw).get('tools') or []
+        self.server.offered.append({tool['function']['name'] for tool in tools})
+        self.rfile = io.BytesIO(raw)
+        super().do_POST()
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+@pytest.mark.parametrize("daemon, form, offered", [
+    ({}, True, True),
+    ({}, False, False),
+    ({"agent": {"disabled_toolsets": ["clarify"]}}, True, False),
+], indirect=["daemon"], ids=["form-elicitation", "no-elicitation", "form-but-disabled"])
+async def test_new_acp_session_offers_clarify_to_a_form_editor(daemon, tmp_path, model_peer, form, offered):
+    model_peer.RequestHandlerClass = OfferRecordingPeer
+    model_peer.offered = []
+    async with editor(daemon, tmp_path) as acp:
+        capabilities = {"elicitation": {"form": {}}} if form else {}
+        assert "result" in await acp.rpc("initialize", protocolVersion=1, clientCapabilities=capabilities)
+        sid = (await acp.rpc("session/new", cwd=str(tmp_path), mcpServers=[]))["result"]["sessionId"]
+        turn = asyncio.create_task(acp.rpc("session/prompt", sessionId=sid,
+                                           prompt=[{"type": "text", "text": "Ask my color"}]))
+        if offered:
+            deadline = time.monotonic() + 30
+            while not any(f.get("method") == "elicitation/create" for f in acp.frames):
+                assert not turn.done(), turn.result()
+                assert time.monotonic() < deadline, "no elicitation/create reached the editor"
+                await asyncio.sleep(.05)
+            request = next(f for f in acp.frames if f.get("method") == "elicitation/create")
+            assert request["params"]["message"].startswith("Pick a color")
+            acp.process.stdin.write(json.dumps({"jsonrpc": "2.0", "id": request["id"], "result": {
+                "action": "accept", "content": {"answer": "green"}}}).encode() + b"\n")
+            await acp.process.stdin.drain()
+        reply = await asyncio.wait_for(turn, 40)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+    turns = [tools for tools in model_peer.offered if tools]  # auxiliary calls offer no tools
+    assert turns and all(("clarify" in tools) == offered for tools in turns), turns
+    asked = [f for f in acp.frames if f.get("method") in ("elicitation/create", "session/request_permission")]
+    assert len(asked) == (1 if offered else 0), asked
+    if offered:
+        tool_results = [m for messages in model_peer.requests for m in messages if m["role"] == "tool"]
+        assert any("green" in json.dumps(m) for m in tool_results), tool_results
