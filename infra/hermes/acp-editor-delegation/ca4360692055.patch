diff --git a/tests/acp_adapter/test_gateway_editor_delegation.py b/tests/acp_adapter/test_gateway_editor_delegation.py
new file mode 100644
index 0000000000..627f697244
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_editor_delegation.py
@@ -0,0 +1,202 @@
+"""An editor that asks for it gets foreground delegation and nested subagents in its ACP sessions.
+
+Real gateway daemon, real ``hermes acp`` stdio process (``acp_adapter.entry``, the ``GatewayACPAgent`` viewer),
+real parent and child ``AIAgent``s against a loopback model. The editor advertises
+``clientCapabilities._meta.hermes.delegation`` in ``initialize``; ``session.create`` carries it to the owner.
+Without it, a top-level ``delegate_task`` detaches as before and children are leaves (``max_spawn_depth: 1``).
+"""
+import asyncio
+from http.server import BaseHTTPRequestHandler
+import json
+import re
+import threading
+
+import pytest
+
+from tests.acp_adapter.test_gateway_sessions import editor
+from tests.waiting import async_wait_until
+
+NESTED_RULE = "Children can themselves delegate"
+
+
+def _text(content):
+    if isinstance(content, list):
+        return "".join(part.get("text", "") for part in content if isinstance(part, dict))
+    return content or ""
+
+
+class ScriptedModel(BaseHTTPRequestHandler):
+    """Agents told apart by the ``LEVEL<n>_TASK`` goal in their first user message (none: the root).
+
+    An agent offered ``delegate_task`` delegates one level down, to ``server.target`` at most; the deepest
+    answers ``LEAF_ANSWER``, and each launcher passes it up. Each request records its level and offered tools."""
+
+    def log_message(self, *args):
+        pass
+
+    def do_GET(self):
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps({"data": [{"id": "local-wire-stub", "object": "model"}]}).encode())
+
+    def do_POST(self):
+        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+        messages = body.get("messages") or []
+        offered = {t["function"]["name"]: t["function"] for t in body.get("tools") or []}
+        asked = " ".join(_text(m.get("content")) for m in messages if m.get("role") == "user")
+        results = [_text(m.get("content")) for m in messages if m.get("role") == "tool"]
+        levels = [int(n) for n in re.findall(r"LEVEL(\d)_TASK", asked)]
+        level = "hang" if "HANG_TASK" in asked else max(levels, default=0)
+        if offered:  # auxiliary calls offer no tools
+            self.server.calls.append({"level": level, "offered": offered, "results": results})
+        call = None
+        if not offered:
+            reply = "ok"
+        elif level == "hang":
+            self.server.hanging.set()
+            self.server.release.wait(60)
+            reply = "HANG_ANSWER"
+        elif results:
+            reply = "ROOT_DONE" if level == 0 else f"L{level} saw " + (
+                "LEAF_ANSWER" if "LEAF_ANSWER" in results[-1] else "nothing")
+        elif level == 0:
+            call = self.server.root_call
+        elif "delegate_task" in offered and level < self.server.target:
+            call = {"tasks": [{"goal": f"LEVEL{level + 1}_TASK: delegate one level down if you can, then report"}]}
+        else:
+            reply = "LEAF_ANSWER"
+        message = {"role": "assistant", "content": reply} if call is None else {
+            "role": "assistant", "content": None, "tool_calls": [{
+                "index": 0, "id": f"call-{len(self.server.calls)}", "type": "function",
+                "function": {"name": "delegate_task", "arguments": json.dumps(call)}}]}
+        finish = "stop" if call is None else "tool_calls"
+        try:
+            self.send_response(200)
+            self.send_header("Content-Type", "text/event-stream" if body.get("stream") else "application/json")
+            self.end_headers()
+            base = {"id": "local", "model": "local-wire-stub", "created": 1}
+            if body.get("stream"):
+                for delta, end in [(message, None), ({}, finish)]:
+                    chunk = {**base, "object": "chat.completion.chunk",
+                             "choices": [{"index": 0, "delta": delta, "finish_reason": end}]}
+                    self.wfile.write(("data: " + json.dumps(chunk) + "\n\n").encode())
+                self.wfile.write(b"data: [DONE]\n\n")
+            else:
+                self.wfile.write(json.dumps({**base, "object": "chat.completion", "choices": [
+                    {"index": 0, "message": message, "finish_reason": finish}]}).encode())
+            self.wfile.flush()
+        except OSError:
+            pass  # an interrupted child hung up
+
+
+@pytest.fixture
+def scripted(model_peer):
+    model_peer.RequestHandlerClass = ScriptedModel
+    model_peer.calls, model_peer.hanging, model_peer.release = [], threading.Event(), threading.Event()
+    model_peer.target = 3
+    yield model_peer
+    model_peer.release.set()
+
+
+def _capabilities(delegation):
+    return {"_meta": {"hermes": {"delegation": delegation}}} if delegation is not None else {}
+
+
+async def _session(acp, tmp_path, delegation):
+    assert "result" in await acp.rpc("initialize", protocolVersion=1, clientCapabilities=_capabilities(delegation))
+    created = await acp.rpc("session/new", cwd=str(tmp_path), mcpServers=[])
+    assert "result" in created, created
+    return created["result"]["sessionId"]
+
+
+def _at(scripted, level):
+    return [call for call in scripted.calls if call["level"] == level]
+
+
+def _prompt(acp, sid, text="Please do the work"):
+    return asyncio.create_task(acp.rpc("session/prompt", sessionId=sid, prompt=[{"type": "text", "text": text}]))
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+@pytest.mark.parametrize("delegation, background, offered, joined", [
+    ({"foreground": True}, None, True, True),
+    ({"foreground": True}, True, True, False),
+    (None, None, False, False),
+    (None, False, False, False),
+], ids=["foreground-default", "foreground-picks-background", "stock", "stock-ignores-background-false"])
+async def test_an_editor_session_lets_the_model_wait_for_its_subagents(
+        daemon, tmp_path, scripted, delegation, background, offered, joined):
+    scripted.root_call = {"tasks": [{"goal": "LEVEL1_TASK: reply with one word"}],
+                          **({} if background is None else {"background": background})}
+    async with editor(daemon, tmp_path) as acp:
+        sid = await _session(acp, tmp_path, delegation)
+        reply = await asyncio.wait_for(_prompt(acp, sid), 60)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+        await async_wait_until(lambda: _at(scripted, 1), 30, what="the child ran")
+    first, second = _at(scripted, 0)[:2]
+    delegate = first["offered"]["delegate_task"]
+    assert ("background" in delegate["parameters"]["properties"]) is offered
+    assert ("By default the call waits" in delegate["description"]) is offered
+    result = second["results"][-1]
+    if joined:
+        assert "LEAF_ANSWER" in result and '"dispatched"' not in result, result
+        chunks = [f for f in acp.frames if f.get("method") == "session/update"
+                  and f["params"]["update"].get("sessionUpdate") == "agent_message_chunk"]
+        assert "ROOT_DONE" in "".join(f["params"]["update"]["content"].get("text", "") for f in chunks)
+    else:
+        assert '"dispatched"' in result and "LEAF_ANSWER" not in result, result
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+@pytest.mark.parametrize("daemon, depth, deepest, profile_depth", [
+    ({}, 3, 3, False),
+    ({}, None, 1, False),
+    ({"delegation": {"orchestrator_enabled": False}}, 3, 1, False),
+    ({"delegation": {"max_spawn_depth": 2}}, 1, 2, True),
+], indirect=["daemon"], ids=["session-depth", "profile-default", "orchestrators-off", "profile-depth-is-a-floor"])
+async def test_an_editor_session_nests_to_the_depth_it_asked_for(
+        daemon, tmp_path, scripted, depth, deepest, profile_depth):
+    scripted.root_call = {"tasks": [{"goal": "LEVEL1_TASK: delegate one level down if you can, then report"}]}
+    delegation = {"foreground": True, **({} if depth is None else {"maxSpawnDepth": depth})}
+    async with editor(daemon, tmp_path) as acp:
+        sid = await _session(acp, tmp_path, delegation)
+        reply = await asyncio.wait_for(_prompt(acp, sid), 120)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+    assert max(call["level"] for call in scripted.calls) == deepest
+    for level in range(deepest + 1):
+        offered = _at(scripted, level)[0]["offered"]
+        assert ("delegate_task" in offered) is (level < deepest), level
+        described = level < deepest and NESTED_RULE in offered["delegate_task"]["description"]
+        if level + 1 < deepest:  # a launcher whose children may delegate in turn is told so
+            assert described, level
+        elif not profile_depth:  # (a profile's own max_spawn_depth words every level, as stock does)
+            assert not described, level
+    assert "LEAF_ANSWER" in _at(scripted, 0)[-1]["results"][-1]
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_stopping_the_turn_stops_its_foreground_subagents(daemon, tmp_path, scripted):
+    scripted.root_call = {"tasks": [{"goal": "HANG_TASK: take your time"}]}
+    async with editor(daemon, tmp_path) as acp:
+        sid = await _session(acp, tmp_path, {"foreground": True})
+        turn = _prompt(acp, sid)
+        await async_wait_until(scripted.hanging.is_set, 30, what="the child's model call")
+        acp.process.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "session/cancel",
+                                            "params": {"sessionId": sid}}).encode() + b"\n")
+        await acp.process.stdin.drain()
+        reply = await asyncio.wait_for(turn, 30)
+        assert reply.get("result", {}).get("stopReason") == "cancelled", reply
+
+        def ended():
+            updates = [f["params"]["update"] for f in acp.frames if f.get("method") == "session/update"]
+            return next((u for u in updates if u.get("sessionUpdate") == "tool_call_update"
+                         and u.get("status") in ("completed", "failed")), None)
+
+        update = await async_wait_until(ended, 30, what="the delegate_task call to end")
+        results = (update.get("rawOutput") or {}).get("results") or []
+        assert [r.get("status") for r in results] == ["interrupted"], update  # its model call never returned
+    assert not [c for c in _at(scripted, 0) if c["results"]], "the parent must not answer after a stop"
