diff --git a/tools/delegate_tool_session.py b/tools/delegate_tool_session.py
new file mode 100644
index 0000000000..d1b61cd554
--- /dev/null
+++ b/tools/delegate_tool_session.py
@@ -0,0 +1,150 @@
+"""Delegation settings a client negotiates for its session at ``session.create`` (``delegation``).
+
+``foreground``: the client shows a delegation's children while the call runs (``hermes acp`` for an editor
+that says so), so the session's ``delegate_task`` lets the model choose per call. ``background: false`` (the
+default) joins the children inside the call, as an orchestrator child or a one-shot run does, and the parent
+answers in the same turn; stopping the turn stops them. ``background: true`` detaches them as a stock gateway
+session always does. A profile with ``delegation.gateway_mode: inline`` keeps joining every call.
+
+``max_spawn_depth``: how deep this session's subagents may nest. It raises ``delegation.max_spawn_depth``,
+whose default of 1 keeps chat sessions flat, and never lowers it; ``delegation.orchestrator_enabled: false``
+still makes every child a leaf. Children carry the session's depth to their own children.
+
+Both freeze into the session's policy, and onto its agent at the first tool build, like
+``delegation.gateway_mode``: dispatch follows the ``delegate_task`` schema the session carries.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from contextlib import contextmanager
+from contextvars import ContextVar
+from typing import Any, Iterator, Optional
+
+_SESSION_DELEGATION: ContextVar[Optional[dict]] = ContextVar("hermes_session_delegation", default=None)
+
+_CHOICE_DELIVERY = (
+    "By default the call waits: the subagents run (in parallel when there are several) and their results return "
+    "in this tool call, so you can use them in this turn. Set `background: true` to run them in the background "
+    "instead: dispatch returns live transcript paths and results re-enter as a new message when subagents finish "
+    "({delivery}). Background results are delivered only BETWEEN your turns: finish whatever does not depend on "
+    "them, then give a one-line status and END YOUR TURN. Never wait or poll on transcripts, artifact files, or CI "
+    "for a background child. While background children run, `action` (list/steer/stop) controls them live.\n\n"
+)
+_BACKGROUND_PARAM = {
+    "type": "boolean",
+    "description": "Run the subagents in the background (true): the call returns at once and their results arrive "
+                   "after your turn ends. Default false: wait for them in this call.",
+}
+# The leaf rule as ``model_tools`` trimmed it to the session's tools (it drops the line when none remain).
+_LEAF_LINE = re.compile(r"- Children cannot call delegate_task(?:, | or |\.)([^\n]*)\n")
+_NESTED_LINE = ("- Children can themselves delegate while depth remains (max_spawn_depth={depth}); the runtime "
+                "derives this from depth automatically.\n")
+_NESTED_DEPTH = re.compile(r"(delegate while depth remains \(max_spawn_depth=)\d+")
+_TAIL = "- Children inherit the parent model"
+
+
+def _nested_description(description: str, depth: int) -> str:
+    """The stock nested-delegation rule at *depth*, in place of the leaf rule."""
+    if _NESTED_DEPTH.search(description):
+        return _NESTED_DEPTH.sub(rf"\g<1>{depth}", description)
+    nested = _NESTED_LINE.format(depth=depth)
+    match = _LEAF_LINE.search(description)
+    if match is None:
+        at = description.find(_TAIL)
+        return description[:at] + nested + description[at:] if at != -1 else description
+    names = [name for name in re.split(r", or |, | or ", match.group(1).strip().rstrip(".")) if name]
+    joined = " or ".join(names) if len(names) <= 2 else ", ".join(names[:-1]) + ", or " + names[-1]
+    kept = f"- Children cannot call {joined}.\n" if names else ""
+    return description[:match.start()] + kept + nested + description[match.end():]
+
+
+def validate_session_delegation(value: Any) -> None:
+    """``session.create``'s ``delegation``: ``{"foreground": bool, "max_spawn_depth": int >= 1}``, both optional."""
+    from hermes_state_runtime import RuntimeStoreError
+    if value is None:
+        return
+    if not isinstance(value, dict):
+        raise RuntimeStoreError('invalid_params', field='delegation',
+                                detail=f'must be a mapping, got {type(value).__name__}')
+    unknown = sorted(set(value) - {'foreground', 'max_spawn_depth'})
+    if unknown:
+        raise RuntimeStoreError('invalid_params', field=f'delegation.{unknown[0]}', detail='unknown delegation key')
+    if type(value.get('foreground', False)) is not bool:
+        raise RuntimeStoreError('invalid_params', field='delegation.foreground', detail='must be a boolean')
+    depth = value.get('max_spawn_depth', 1)
+    if type(depth) is not int or depth < 1:
+        raise RuntimeStoreError('invalid_params', field='delegation.max_spawn_depth',
+                                detail='must be an integer of at least 1')
+
+
+@contextmanager
+def session_delegation_scope(runner: Any, source: Any) -> Iterator[None]:
+    """Build a session's agent with the ``delegation`` its creation request carries (none for other sessions)."""
+    from gateway.session_policy import policy_for_source
+    policy = policy_for_source(runner, source)
+    settings = json.loads(policy.request_json).get('delegation') if policy is not None else None
+    token = _SESSION_DELEGATION.set(settings if isinstance(settings, dict) else None)
+    try:
+        yield
+    finally:
+        _SESSION_DELEGATION.reset(token)
+
+
+def session_delegation(agent: Any) -> dict:
+    """*agent*'s session settings, frozen at its first tool build (a child is stamped with its parent's)."""
+    cached = getattr(agent, "_session_delegation", None)
+    if not isinstance(cached, dict):
+        cached = dict(_SESSION_DELEGATION.get() or {})
+        agent._session_delegation = cached
+    return cached
+
+
+def spawn_depth_for(agent: Any) -> int:
+    """``delegation.max_spawn_depth``, raised to the depth *agent*'s session negotiated."""
+    from tools.delegate_tool import _get_max_spawn_depth  # through the origin, so tests can patch it
+    depth = _get_max_spawn_depth()
+    negotiated = session_delegation(agent).get("max_spawn_depth")
+    return max(depth, negotiated) if isinstance(negotiated, int) else depth
+
+
+def session_delegate_function(function: dict, agent: Any) -> dict:
+    """A built ``delegate_task`` definition as *agent*'s session negotiated it: the ``background`` choice for
+    the top-level agent, and at any depth whether *agent*'s children may delegate in turn."""
+    from tools.delegate_tool import _DELIVERY_INDEPENDENT, _DELIVERY_JOINED, _DESCRIPTION_DELIVERY
+    from tools.delegate_tool_config import _get_orchestrator_enabled
+    settings = session_delegation(agent)
+    depth = getattr(agent, "_delegate_depth", 0)
+    description = function.get("description") or ""
+    params = function["parameters"]
+    if settings.get("foreground") is True and depth == 0:
+        for delivery in (_DELIVERY_INDEPENDENT, _DELIVERY_JOINED):
+            description = description.replace(_DESCRIPTION_DELIVERY.format(delivery=delivery),
+                                              _CHOICE_DELIVERY.format(delivery=delivery))
+        params = {**params, "properties": {**params["properties"], "background": _BACKGROUND_PARAM}}
+    spawn_depth = spawn_depth_for(agent)
+    if depth + 1 < spawn_depth and _get_orchestrator_enabled():
+        description = _nested_description(description, spawn_depth)
+    return {**function, "description": description, "parameters": params}
+
+
+def session_tool_schemas(agent: Any, tools: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """*tools* with *agent*'s ``delegate_task`` as its session negotiated it (unchanged without settings).
+    A child's first tool build runs before it is stamped with its depth, so ``_build_child_agent`` reapplies it."""
+    if not tools or not session_delegation(agent):
+        return tools
+    return [
+        {**tool, "function": session_delegate_function(tool["function"], agent)}
+        if (tool.get("function") or {}).get("name") == "delegate_task" else tool
+        for tool in tools
+    ]
+
+
+def session_chooses_background(agent: Any) -> bool:
+    """Whether the ``delegate_task`` *agent* carries lets the model pick ``background`` (its pinned bytes decide)."""
+    for tool in getattr(agent, "tools", None) or ():
+        function = tool.get("function") if isinstance(tool, dict) else None
+        if isinstance(function, dict) and function.get("name") == "delegate_task":
+            return "background" in ((function.get("parameters") or {}).get("properties") or {})
+    return False
