+"""The delegation settings an editor asks ``hermes acp`` for in ``initialize``.
+
+``clientCapabilities._meta.hermes.delegation``: ``foreground`` (the editor shows a delegation's children
+while the call runs, so its sessions' model may wait on them in the call) and ``maxSpawnDepth`` (how deep
+their subagents may nest). ``session.create`` carries them as ``delegation`` only to a gateway whose
+descriptor lists that field, so an owner still running older code is never sent one it would refuse.
+See ``tools/delegate_tool_session.py`` for what the owner does with them.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+
+def requested_delegation(initialize_params: Any) -> dict:
+    capabilities = initialize_params.get("clientCapabilities") if isinstance(initialize_params, dict) else None
+    meta = capabilities.get("_meta") if isinstance(capabilities, dict) else None
+    hermes = meta.get("hermes") if isinstance(meta, dict) else None
+    asked = hermes.get("delegation") if isinstance(hermes, dict) else None
+    if not isinstance(asked, dict):
+        return {}
+    settings = {}
+    if asked.get("foreground") is True:
+        settings["foreground"] = True
+    depth = asked.get("maxSpawnDepth")
+    if type(depth) is int and depth >= 1:
+        settings["max_spawn_depth"] = depth
+    return settings
+
+
+def delegation_create_fields(requested: dict, descriptor: dict) -> dict:
+    """``session.create`` keyword arguments for *requested*, given the owner's ``runtime.describe``."""
+    parameters = (descriptor.get("session_create") or {}).get("parameters") or ()
+    return {"delegation": requested} if requested and "delegation" in parameters else {}
