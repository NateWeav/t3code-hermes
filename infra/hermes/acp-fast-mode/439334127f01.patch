+def mark_fast_mode_models(state: SessionModelState) -> SessionModelState:
+    """Tag rows whose route takes fast mode with ``_meta.hermes.fastMode`` — the ``/fast`` gate,
+    per row — so a client offers the ``fast_mode`` session option only where it changes the
+    request."""
+    from hermes_cli.config import get_compatible_custom_providers, load_config_readonly
+    from hermes_cli.models import model_supports_fast_mode, resolve_fast_mode_overrides
+    from hermes_cli.providers import custom_provider_slug
+
+    endpoints: dict[str, str] | None = None
+    rows = []
+    for row in state.available_models:
+        # Cheap pre-filter on the trailing id segment before parsing the provider prefix.
+        if not model_supports_fast_mode(row.model_id.split(":")[-1]):
+            rows.append(row)
+            continue
+        provider = _choice_provider(row.model_id)
+        model = row.model_id[len(provider) + 1:] if row.model_id.lower().startswith(provider + ":") else row.model_id
+        base_url = None
+        if provider.startswith("custom:"):
+            if endpoints is None:
+                endpoints = {
+                    custom_provider_slug(str(e.get("name") or ""), str(e.get("provider_key") or "")): str(e.get("base_url") or "")
+                    for e in get_compatible_custom_providers(load_config_readonly())
+                }
+            base_url = endpoints.get(provider)
+        if (provider.startswith("custom") and not base_url) or resolve_fast_mode_overrides(
+                model, provider=provider, base_url=base_url) is None:
+            rows.append(row)
+            continue
+        meta = dict(row.field_meta or {})
+        meta["hermes"] = {**(meta.get("hermes") or {}), "fastMode": True}
+        rows.append(row.model_copy(update={"field_meta": meta}))
+    return state.model_copy(update={"available_models": rows})
+
+
