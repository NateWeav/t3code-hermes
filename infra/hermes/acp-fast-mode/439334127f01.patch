new file mode 100644
index 0000000000..cd6add1776
--- /dev/null
+++ b/tests/acp_adapter/test_fast_mode.py
@@ -0,0 +1,109 @@
+"""Session-scoped fast mode over ACP, and the per-endpoint opt-in that lets a proxy receive it.
+
+Real config-file → ``load_config`` → fast-mode gate chain on the per-test ``HERMES_HOME``; only the
+agent and the model inventory are stubbed.
+"""
+
+import os
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import hermes_yaml as yaml
+import pytest
+from acp.schema import ModelInfo, SessionModelState
+
+from acp_adapter.model_catalog import mark_fast_mode_models
+from acp_adapter.server import HermesACPAgent
+from acp_adapter.session import SessionManager
+from hermes_cli.models import resolve_fast_mode_overrides
+
+PROXY = "http://proxy.test:8317/v1"
+
+
+@pytest.fixture
+def hermes_config(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    def write(custom_providers: list[dict]) -> None:
+        (Path(os.environ["HERMES_HOME"]) / "config.yaml").write_text(
+            yaml.safe_dump({"custom_providers": custom_providers}), encoding="utf-8")
+
+    write([
+        {"name": "proxy", "base_url": PROXY, "capabilities": {"fast_mode": True}},
+        {"name": "plain", "base_url": "http://plain.test/v1"},
+    ])
+    return write
+
+
+def _agent(**overrides):
+    fields = {"model": "gpt-5.5", "provider": "custom", "base_url": PROXY, "api_mode": "chat_completions",
+              "request_overrides": {"extra_body": {"tags": ["t3"]}}, "service_tier": None}
+    return SimpleNamespace(**{**fields, **overrides})
+
+
+def test_opted_in_endpoint_receives_service_tier_only(hermes_config):
+    assert resolve_fast_mode_overrides("gpt-5.5", provider="custom", base_url=PROXY + "/") == {
+        "service_tier": "priority"}
+    # Anthropic's ``speed`` is a Messages API parameter; a chat-completions proxy never gets it.
+    assert resolve_fast_mode_overrides("claude-opus-5-5", provider="custom", base_url=PROXY) is None
+    # Without the capability a proxy stays gated, as before.
+    assert resolve_fast_mode_overrides("gpt-5.5", provider="custom", base_url="http://plain.test/v1") is None
+
+
+def test_model_rows_carry_fast_mode_meta_where_the_route_takes_it(hermes_config):
+    ids = ["custom:proxy:gpt-5.5", "custom:proxy:claude-opus-5-5", "custom:proxy:glm-5.1",
+           "custom:plain:gpt-5.5", "openai-codex:gpt-5.5", "openrouter:openai/gpt-5.5"]
+    state = SessionModelState(available_models=[ModelInfo(model_id=i, name=i) for i in ids],
+                              current_model_id=ids[0])
+
+    marked = mark_fast_mode_models(state)
+
+    fast = [m.model_id for m in marked.available_models if (m.field_meta or {}).get("hermes", {}).get("fastMode")]
+    assert fast == ["custom:proxy:gpt-5.5", "openai-codex:gpt-5.5"]
+    assert marked.current_model_id == ids[0]
+
+
+@pytest.mark.asyncio
+async def test_new_session_advertises_fast_rows_without_a_config_option(hermes_config):
+    acp_agent = HermesACPAgent(session_manager=SessionManager(agent_factory=_agent))
+    picker = SessionModelState(available_models=[ModelInfo(model_id="custom:proxy:gpt-5.5", name="gpt-5.5")],
+                               current_model_id="custom:proxy:gpt-5.5")
+    with patch("acp_adapter.server.build_model_state", return_value=picker):
+        resp = await acp_agent.new_session(cwd="/tmp")
+
+    assert resp.config_options is None
+    assert resp.models.available_models[0].field_meta == {"hermes": {"fastMode": True}}
+
+
+@pytest.mark.asyncio
+async def test_fast_mode_option_pins_the_tier_and_survives_an_agent_rebuild(hermes_config):
+    acp_agent = HermesACPAgent(session_manager=SessionManager(agent_factory=_agent))
+    sid = (await acp_agent.new_session(cwd="/tmp")).session_id
+    state = acp_agent.session_manager.get_session(sid)
+
+    await acp_agent.set_config_option("fast_mode", sid, "on")
+    assert state.agent.request_overrides == {"extra_body": {"tags": ["t3"]}, "service_tier": "priority"}
+    assert state.agent.service_tier == "priority"
+
+    # set_model / resume rebuild the agent from config; the next turn re-pins the choice.
+    state.agent = _agent()
+    HermesACPAgent._apply_fast_mode(state)
+    assert state.agent.request_overrides["service_tier"] == "priority"
+
+    await acp_agent.set_config_option("fast_mode", sid, "off")
+    assert state.agent.request_overrides == {"extra_body": {"tags": ["t3"]}}
+    assert state.agent.service_tier is None
+
+
+@pytest.mark.asyncio
+async def test_fast_mode_on_an_unsupported_route_sends_nothing(hermes_config):
+    acp_agent = HermesACPAgent(session_manager=SessionManager(
+        agent_factory=lambda: _agent(base_url="http://plain.test/v1")))
+    sid = (await acp_agent.new_session(cwd="/tmp")).session_id
+
+    await acp_agent.set_config_option("fast_mode", sid, "on")
+
+    agent = acp_agent.session_manager.get_session(sid).agent
+    assert "service_tier" not in agent.request_overrides
+    assert agent.service_tier is None
