diff --git a/tests/acp_adapter/test_gateway_launch_yolo_resume.py b/tests/acp_adapter/test_gateway_launch_yolo_resume.py
new file mode 100644
index 0000000000..879cecab52
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_launch_yolo_resume.py
@@ -0,0 +1,85 @@
+"""A reopened or forked editor session takes the approval bypass of the ``hermes acp`` launch reopening it.
+
+``session.create`` freezes ``--yolo`` (``HERMES_YOLO_MODE``) into a new session's policy, but an editor
+that relaunches ``hermes acp`` to change approval mode reopens the session it already has. Real
+authority + SQLite + dispatch; only the socket is replaced.
+"""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+
+class _Bridge:
+    """``GatewayClient.rpc`` over a real ``AuthorityConnection.dispatch`` (no socket)."""
+
+    def __init__(self, connection):
+        self.connection, self.events = connection, asyncio.Queue()
+
+    async def rpc(self, method, _timeout=None, **params):
+        from hermes_cli.gateway_client import GatewayClientError
+        reply = await self.connection.dispatch({'id': 1, 'method': method, 'params': params})
+        if 'error' in reply:
+            raise GatewayClientError(reply['error']['message'])
+        return reply['result']
+
+
+class _Editor:
+    async def session_update(self, session_id, update, **kwargs):
+        pass
+
+
+@pytest.mark.asyncio
+async def test_reopen_and_fork_follow_the_launch_yolo(tmp_path, monkeypatch):
+    from gateway import run
+    from gateway.config import GatewayConfig
+    from gateway.session import AsyncSessionStore, SessionStore
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_controls import AuthorityConnection
+    from gateway.session_local import create_local_session
+    from acp_adapter.gateway_server import GatewayACPAgent
+    from tools.approval import is_session_yolo_enabled
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.delenv('HERMES_YOLO_MODE', raising=False)
+    monkeypatch.setattr(run, '_load_gateway_config', lambda: {'platform_toolsets': {'acp': []}})
+    store = SessionStore(tmp_path / 'sessions', GatewayConfig())
+    runner = SimpleNamespace(session_store=store, _session_db=store._db, adapters={}, _draining=False,
+                             _cached_agent_for=lambda route: None)
+    runner.async_session_store = AsyncSessionStore(store)
+    runner._adapter_for_source = lambda source: runner.adapters.get(source.platform)
+    authority = await initialize_session_authority(runner, profile_id='fixture', instance_id='owner')
+    try:
+        connection = AuthorityConnection(authority, object(), {'user_id': 'human', 'profile_id': 'fixture'})
+        bridge = _Bridge(connection)
+        ref = create_local_session(authority, connection.actor, {
+            'request_id': 'editor', 'source': 'acp', 'cwd': str(tmp_path), 'model': 'frozen', 'toolsets': []})
+
+        def editor():
+            agent = GatewayACPAgent()
+            agent._home = tmp_path
+            agent._gateway, agent._conn = bridge, _Editor()
+            return agent
+
+        async def yolo(session_id):
+            value = (await bridge.rpc('config.get', session_id=session_id, key='yolo'))['value']
+            assert (value == '1') == is_session_yolo_enabled(authority.sessions[session_id].route)
+            return value
+
+        assert await yolo(ref.session_id) == '0'
+
+        # A Full-access relaunch reopens the session it created without the flag.
+        monkeypatch.setenv('HERMES_YOLO_MODE', '1')
+        await editor().load_session(cwd=str(tmp_path), session_id=ref.session_id, mcp_servers=[])
+        assert await yolo(ref.session_id) == '1'
+
+        # Back to an approval mode: the bypass is revoked, not left on from the last launch.
+        monkeypatch.delenv('HERMES_YOLO_MODE')
+        await editor().resume_session(cwd=str(tmp_path), session_id=ref.session_id, mcp_servers=[])
+        assert await yolo(ref.session_id) == '0'
+
+        monkeypatch.setenv('HERMES_YOLO_MODE', '1')
+        forked = await editor().fork_session(cwd=str(tmp_path), session_id=ref.session_id, mcp_servers=[])
+        assert await yolo(forked.session_id) == '1'
+    finally:
+        store.close_all_db_handles()
