+@pytest.mark.asyncio
+async def test_follower_released_before_its_withdrawal_keeps_running():
+    # Another viewer's discard can start the follower between the refusal and the withdrawal: it is
+    # then the user's running turn, never interrupted, and the refusal says it was kept.
+    from hermes_cli.gateway_client import GatewayRPCError
+    agent = GatewayACPAgent()
+    agent._gateway = AsyncMock()
+    agent._snapshots['s'] = {}
+    calls = []
+
+    async def rpc(method, **params):
+        calls.append(method)
+        if method == 'prompt.cancel':
+            raise GatewayRPCError('stale_generation')
+        assert method == 'prompt.submit'
+        await agent._project({'session_id': 's', 'type': 'session.info', 'payload': {'pending': [
+            {'admission_id': 'head', 'status': 'unknown'}, {'admission_id': 'ours', 'status': 'queued'}]}})
+        return {'admission_id': 'ours'}
+
+    agent._gateway.rpc.side_effect = rpc
+    with pytest.raises(GatewayClientError, match=r'\(your input is accepted and kept\)'):
+        await asyncio.wait_for(agent.prompt([acp.text_block('queued')], 's'), 5)
+    assert calls == ['prompt.submit', 'prompt.cancel']
+
+
+@pytest.mark.asyncio
+async def test_reconnect_that_adopts_a_lost_turn_submits_nothing():
+    # A gateway restart leaves the cached snapshot stale until the submit path reconnects; the
+    # reconnect's re-attach is the first to see the lost turn, and the prompt must not queue behind it.
+    agent = GatewayACPAgent()
+    agent._snapshots['s'] = {}
+    gateway = AsyncMock()
+
+    async def reconnect():
+        agent._snapshots['s'] = {'pending': [{'admission_id': 'lost', 'status': 'unknown'}]}
+        return gateway
+
+    agent._client = reconnect
+    with pytest.raises(GatewayClientError, match=r'\(nothing was submitted\)'):
+        await asyncio.wait_for(agent.prompt([acp.text_block('continue')], 's'), 5)
+    gateway.rpc.assert_not_awaited()
+    assert 's' not in agent._unacked
+
+
