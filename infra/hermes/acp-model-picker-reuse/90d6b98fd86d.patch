+++ b/tests/acp_adapter/test_gateway_model_picker_reuse.py
@@ -0,0 +1,89 @@
+"""The model picker a session's open, its first mode pick and the owner's echoes all ask for within a
+second is built once for them, and once ahead of the first session by ``hermes acp`` itself."""
+from concurrent.futures import ThreadPoolExecutor
+import threading
+from unittest.mock import AsyncMock
+
+from acp.schema import ModelInfo, SessionModelState
+import pytest
+
+from acp_adapter import gateway_session_meta
+from acp_adapter.gateway_server import GatewayACPAgent
+
+
+@pytest.fixture
+def builds(monkeypatch):
+    """Each picker build's ``(model, provider)``, with the inventory stubbed to one row."""
+    calls = []
+
+    def build(model, provider, _base_url):
+        calls.append((model, provider))
+        choice = f"{provider}:{model}"
+        return SessionModelState(available_models=[ModelInfo(model_id=choice, name=model)], current_model_id=choice)
+
+    monkeypatch.setattr("acp_adapter.model_catalog.build_model_state", build)
+    return calls
+
+
+@pytest.mark.asyncio
+async def test_session_open_and_its_mode_pick_build_the_picker_once(builds, tmp_path):
+    info = {"cwd": str(tmp_path), "model": "model-a", "provider": "provider-a", "edit_approval_policy": "ask"}
+    snapshot = {"session_id": "s", "info": info, "revision": 1, "execution_generation": 0}
+
+    async def rpc(method, **params):
+        if method == "runtime.describe":
+            return {"session_create": {"sources": ["acp"]}, "capabilities": ["acp-editor-policy-v1"]}
+        if method in ("session.create", "session.resume"):
+            return {**snapshot, "info": dict(info)}
+        if method == "session.mutate":
+            info["edit_approval_policy"] = params["payload"]["policy"]
+            return {"status": "applied"}
+        if method == "session.info":
+            return dict(info)
+        assert method == "config.set", method
+        return {"key": params["key"], "value": params["value"], "scope": "session"}
+
+    agent = GatewayACPAgent()
+    agent._gateway = AsyncMock()
+    agent._gateway.rpc.side_effect = rpc
+    created = await agent.new_session(cwd=str(tmp_path))
+    reply = await agent.set_config_option(config_id="edit_approval_policy", session_id="s", value="session")
+
+    assert builds == [("model-a", "provider-a")]
+    assert created.models.current_model_id == "provider-a:model-a"
+    picker = next(option for option in reply.config_options if option.id == "model")
+    assert picker.current_value == "provider-a:model-a"
+
+
+def test_concurrent_builds_share_one_and_each_caller_gets_its_own_copy(monkeypatch):
+    release = threading.Event()
+    calls = []
+
+    def build(model, provider, _base_url):
+        calls.append(model)
+        release.wait(10)
+        return SessionModelState(available_models=[ModelInfo(model_id="p:m", name="m")], current_model_id="p:m")
+
+    monkeypatch.setattr("acp_adapter.model_catalog.build_model_state", build)
+    with ThreadPoolExecutor(2) as pool:
+        first = pool.submit(gateway_session_meta.model_state, {"model": "m", "provider": "p"})
+        second = pool.submit(gateway_session_meta.model_state, {"model": "m", "provider": "p"})
+        release.set()
+        pickers = [first.result(10), second.result(10)]
+    assert calls == ["m"]
+    assert pickers[0] == pickers[1] and pickers[0] is not pickers[1]
+
+
+def test_a_later_build_reads_the_inventory_again(builds, monkeypatch):
+    gateway_session_meta.model_state({"model": "m", "provider": "p"})
+    monkeypatch.setattr(gateway_session_meta, "PICKER_REUSE_SECONDS", 0)
+    gateway_session_meta.model_state({"model": "m", "provider": "p"})
+    assert builds == [("m", "p"), ("m", "p")]
+
+
+def test_warm_up_builds_the_profile_models_picker_for_the_first_session(builds, monkeypatch):
+    monkeypatch.setattr("hermes_cli.config.load_config",
+                        lambda: {"model": {"default": "model-a", "provider": "provider-a"}})
+    gateway_session_meta.warm_model_state()
+    gateway_session_meta.model_state({"model": "model-a", "provider": "provider-a"})
+    assert builds == [("model-a", "provider-a")]
