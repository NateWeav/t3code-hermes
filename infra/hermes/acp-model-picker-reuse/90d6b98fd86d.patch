+# A session's open, its first mode or model pick and the owner's echo of each build this picker within
+# about a second, and every build reads every provider's credentials (a few hundred ms, more while
+# they contend): concurrent and back-to-back builds for one model share one.
+PICKER_REUSE_SECONDS = 5.0
+_pickers: dict[tuple[str, str], tuple[float, Future]] = {}
+_pickers_lock = threading.Lock()
+
+
+def model_state(info: dict) -> SessionModelState | None:
+    """``_build_model_state``, one build shared by the calls for a model within ``PICKER_REUSE_SECONDS``
+    of its start; each caller gets its own copy. Blocking."""
+    from acp_adapter.auth import detect_provider
+    key = (str(info.get("model") or "").strip(), info.get("provider") or detect_provider() or "openrouter")
+    with _pickers_lock:
+        entry = _pickers.get(key)
+        shared = entry is not None and time.monotonic() - entry[0] < PICKER_REUSE_SECONDS
+        if not shared:
+            entry = _pickers[key] = (time.monotonic(), Future())
+    if shared:
+        picker = entry[1].result()
+    else:
+        try:
+            picker = _build_model_state({"model": key[0], "provider": key[1]})
+        except BaseException as exc:
+            with _pickers_lock:
+                if _pickers.get(key) is entry:
+                    del _pickers[key]
+            entry[1].set_exception(exc)
+            raise
+        entry[1].set_result(picker)
+    return None if picker is None else picker.model_copy(deep=True)
+
+
+def warm_model_state() -> None:
+    """Builds the profile model's picker, so the first session's reply finds it built (``hermes acp``
+    runs this as it starts, before an editor's ``session/new`` asks)."""
+    try:
+        from hermes_cli.config import load_config
+        configured = load_config().get("model")
+        configured = configured if isinstance(configured, dict) else {}
+        model_state({"model": configured.get("default"), "provider": configured.get("provider")})
+    except Exception:
+        # Boundary: a warm-up; the session's own build reports any real failure.
+        logger.debug("Could not warm the ACP model picker", exc_info=True)
+
+
