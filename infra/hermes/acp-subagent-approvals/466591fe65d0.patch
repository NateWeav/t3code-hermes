diff --git a/tests/acp_adapter/test_gateway_subagent_approvals.py b/tests/acp_adapter/test_gateway_subagent_approvals.py
new file mode 100644
index 0000000000..d3028225db
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_subagent_approvals.py
@@ -0,0 +1,193 @@
+"""A foreground subagent's approval reaches the editor through its parent's ACP session, naming the subagent.
+
+Real gateway daemon, real ``hermes acp`` stdio process (``acp_adapter.entry``, the ``GatewayACPAgent`` viewer),
+real parent and child ``AIAgent``s against a loopback model. The editor asks for foreground delegation
+(``clientCapabilities._meta.hermes.delegation``), so a child runs while the parent's turn is open and asks on
+the parent's approval route. A background child that asks after that turn ended still has no one to ask, and
+fails closed.
+"""
+import asyncio
+from http.server import BaseHTTPRequestHandler
+import json
+import re
+import shlex
+import threading
+
+import pytest
+
+from tests.acp_adapter.test_gateway_sessions import editor
+from tests.waiting import async_wait_until
+
+
+def _text(content):
+    if isinstance(content, list):
+        return "".join(part.get("text", "") for part in content if isinstance(part, dict))
+    return content or ""
+
+
+class ScriptedModel(BaseHTTPRequestHandler):
+    """Agents told apart by the ``LEVEL<n>_TASK`` goal in their first user message (none: the root).
+
+    Down to ``server.target``, each agent delegates one level down; the deepest runs ``server.command`` with
+    ``terminal`` and answers ``Written.``. Each launcher passes its child's answer up."""
+
+    def log_message(self, *args):
+        pass
+
+    def do_GET(self):
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps({"data": [{"id": "local-wire-stub", "object": "model"}]}).encode())
+
+    def do_POST(self):
+        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+        messages = body.get("messages") or []
+        offered = {t["function"]["name"] for t in body.get("tools") or []}
+        asked = " ".join(_text(m.get("content")) for m in messages if m.get("role") == "user")
+        results = [_text(m.get("content")) for m in messages if m.get("role") == "tool"]
+        level = max((int(n) for n in re.findall(r"LEVEL(\d)_TASK", asked)), default=0)
+        if offered:
+            self.server.calls.append({"level": level, "results": results})
+        call = None
+        if not offered:
+            reply = "ok"
+        elif results:
+            reply = "Written." if level == self.server.target or "Written." in results[-1] else "Failed."
+        elif level < self.server.target:
+            call = ("delegate_task", {"tasks": [{"goal": f"LEVEL{level + 1}_TASK: do the work"}],
+                                      **({"background": True} if level == 0 and self.server.background else {})})
+        else:
+            if self.server.background:  # a background child asks only once the turn that launched it ended
+                self.server.turn_ended.wait(60)
+            call = ("terminal", {"command": self.server.command})
+        message = {"role": "assistant", "content": reply} if call is None else {
+            "role": "assistant", "content": None, "tool_calls": [{
+                "index": 0, "id": f"call-{level}-{len(self.server.calls)}", "type": "function",
+                "function": {"name": call[0], "arguments": json.dumps(call[1])}}]}
+        finish = "stop" if call is None else "tool_calls"
+        try:
+            self.send_response(200)
+            self.send_header("Content-Type", "text/event-stream" if body.get("stream") else "application/json")
+            self.end_headers()
+            base = {"id": "local", "model": "local-wire-stub", "created": 1}
+            if body.get("stream"):
+                for delta, end in [(message, None), ({}, finish)]:
+                    chunk = {**base, "object": "chat.completion.chunk",
+                             "choices": [{"index": 0, "delta": delta, "finish_reason": end}]}
+                    self.wfile.write(("data: " + json.dumps(chunk) + "\n\n").encode())
+                self.wfile.write(b"data: [DONE]\n\n")
+            else:
+                self.wfile.write(json.dumps({**base, "object": "chat.completion", "choices": [
+                    {"index": 0, "message": message, "finish_reason": finish}]}).encode())
+            self.wfile.flush()
+        except OSError:
+            pass
+
+
+@pytest.fixture
+def scripted(model_peer, tmp_path):
+    model_peer.RequestHandlerClass = ScriptedModel
+    model_peer.calls, model_peer.target, model_peer.background = [], 1, False
+    model_peer.turn_ended = threading.Event()
+    target = tmp_path / "owned-removal"
+    target.mkdir()
+    (target / "owned.txt").write_text("disposable")
+    model_peer.removal = target
+    model_peer.command = "rm -r -- " + shlex.quote(str(target))
+    yield model_peer
+    model_peer.turn_ended.set()
+
+
+async def _session(acp, tmp_path):
+    capabilities = {"_meta": {"hermes": {"delegation": {"foreground": True, "maxSpawnDepth": 3}}}}
+    assert "result" in await acp.rpc("initialize", protocolVersion=1, clientCapabilities=capabilities)
+    created = await acp.rpc("session/new", cwd=str(tmp_path), mcpServers=[])
+    assert "result" in created, created
+    return created["result"]["sessionId"]
+
+
+async def _answer(acp, frame, option_id):
+    acp.process.stdin.write(json.dumps({"jsonrpc": "2.0", "id": frame["id"], "result": {
+        "outcome": {"outcome": "selected", "optionId": option_id}}}).encode() + b"\n")
+    await acp.process.stdin.drain()
+
+
+def _permission(acp):
+    return next((f for f in acp.frames if f.get("method") == "session/request_permission"), None)
+
+
+def _delegations(acp):
+    """The ``hermesDelegation`` snapshots ``acp-delegation-progress`` put on the parent's call, in order."""
+    return [f["params"]["update"]["rawOutput"]["hermesDelegation"] for f in acp.frames
+            if f.get("method") == "session/update"
+            and isinstance((f["params"]["update"].get("rawOutput") or {}).get("hermesDelegation"), dict)]
+
+
+def _owned(acp, subagent_id):
+    """The ``delegate_task`` call whose ``hermesDelegation`` updates report *subagent_id*."""
+    return next((f["params"]["update"]["toolCallId"] for f in acp.frames if f.get("method") == "session/update"
+                 and ((f["params"]["update"].get("rawOutput") or {}).get("hermesDelegation") or {}).get("subagent_id")
+                 == subagent_id), None)
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+@pytest.mark.parametrize("depth", [1, 2], ids=["child", "grandchild"])
+async def test_a_foreground_subagent_asks_the_editor_and_names_itself(daemon, tmp_path, scripted, depth):
+    scripted.target = depth
+    async with editor(daemon, tmp_path) as acp:
+        sid = await _session(acp, tmp_path)
+        turn = asyncio.create_task(acp.rpc("session/prompt", sessionId=sid,
+                                           prompt=[{"type": "text", "text": "Please do the work"}]))
+        permission = await async_wait_until(lambda: _permission(acp), 60, what="the subagent's permission request")
+        assert scripted.removal.exists()
+        # The deepest subagent ran the command; a grandchild reports on its top-level ancestor's call.
+        asking = {d["subagent_id"] for d in _delegations(acp) if d["depth"] == depth - 1}
+        assert len(asking) == 1
+        subagent_id = asking.pop()
+        assert permission["params"]["_meta"] == {"hermes": {"subagent": {
+            "subagentId": subagent_id, "toolCallId": _owned(acp, subagent_id)}}}
+        assert _owned(acp, subagent_id) is not None
+        assert permission["params"]["toolCall"]["rawInput"]["command"] == scripted.command
+        await _answer(acp, permission, "allow_once")
+        reply = await asyncio.wait_for(turn, 60)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+    assert not scripted.removal.exists()
+    assert "Written." in _at(scripted, 0)[-1]["results"][-1]
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_the_parent_asks_without_naming_a_subagent(daemon, tmp_path, scripted):
+    scripted.target = 0
+    async with editor(daemon, tmp_path) as acp:
+        sid = await _session(acp, tmp_path)
+        turn = asyncio.create_task(acp.rpc("session/prompt", sessionId=sid,
+                                           prompt=[{"type": "text", "text": "Please do the work"}]))
+        permission = await async_wait_until(lambda: _permission(acp), 60, what="the parent's permission request")
+        assert "_meta" not in permission["params"]
+        await _answer(acp, permission, "allow_once")
+        reply = await asyncio.wait_for(turn, 60)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+    assert not scripted.removal.exists()
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_a_background_subagent_that_asks_after_the_turn_fails_closed(daemon, tmp_path, scripted):
+    scripted.background = True
+    async with editor(daemon, tmp_path) as acp:
+        sid = await _session(acp, tmp_path)
+        reply = await asyncio.wait_for(acp.rpc("session/prompt", sessionId=sid,
+                                               prompt=[{"type": "text", "text": "Please do the work"}]), 60)
+        assert reply.get("result", {}).get("stopReason") == "end_turn", reply
+        scripted.turn_ended.set()
+        await async_wait_until(lambda: [c for c in _at(scripted, 1) if c["results"]], 60,
+                               what="the subagent's command result")
+    assert _permission(acp) is None
+    assert scripted.removal.exists()
+
+
+def _at(scripted, level):
+    return [call for call in scripted.calls if call["level"] == level]
