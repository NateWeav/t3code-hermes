+"""A ``delegate_task`` task's own ``model``, on the gateway path.
+
+A gateway session's agent runs ``delegate_task`` from its turn, and the turn publishes each child's
+``subagent.*`` frames to every viewer (``hermes acp``, the TUI, Desktop). These tests run the real call
+dispatch, ``delegate_task``, route resolution, model inventory and credential resolution against a
+temp profile, and read the frames the turn's real progress callback publishes. Only the child's
+construction and run are stubbed, where a test reads what they were handed.
+"""
+import json
+import threading
+from contextvars import Context
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import hermes_yaml as yaml
+import pytest
+
+from agent.tool_executor import _dispatch_authorized_once, _ManagedToolResult, _ToolCallRef
+from gateway.config import Platform
+from gateway.run_turn_runner import TurnRunner
+from gateway.session_authority import SessionAuthority
+from gateway.session_events import SessionEvents
+
+SID = "s"
+PROXY = "http://127.0.0.1:9/v1"
+LOCAL = "http://127.0.0.1:8/v1"
+PROFILE = {
+    "model": {"default": "claude-haiku-5-5", "provider": "custom:proxy", "base_url": PROXY},
+    "custom_providers": [
+        {"name": "proxy", "base_url": PROXY, "api_key": "proxy-key", "api_mode": "anthropic_messages",
+         "discover_models": False, "models": {"claude-haiku-5-5": {}, "claude-sonnet-5-5": {}}},
+        {"name": "local", "base_url": LOCAL, "api_key": "local-key", "api_mode": "chat_completions",
+         "discover_models": False, "models": {"qwen3-local": {}, "claude-haiku-5-5": {}}},
+    ],
+}
+
+
+@pytest.fixture
+def profile(tmp_path, monkeypatch):
+    """Write the profile's config.yaml; ``managed`` also installs a managed scope over it."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    def write(delegation=None, managed=None):
+        (home / "config.yaml").write_text(yaml.safe_dump({**PROFILE, "delegation": delegation or {}}), encoding="utf-8")
+        if managed is not None:
