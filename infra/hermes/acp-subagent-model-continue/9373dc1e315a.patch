diff --git a/tests/acp_adapter/test_gateway_delegation_continue.py b/tests/acp_adapter/test_gateway_delegation_continue.py
new file mode 100644
index 0000000000..266a4fa7a3
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_delegation_continue.py
@@ -0,0 +1,183 @@
+"""``delegate_task(action="continue")`` reaches an editor through ``hermes acp``, the gateway viewer.
+
+A finished child of the conversation runs again on its own session with a follow-up message, in the background,
+and its new answer re-enters as a completion message, as a spawn's does. These tests run the real ``delegate_task``
+(spawn and continue), the child lifecycle and registry, the async registry's background dispatch and the owner's
+publish path into the viewer ``HermesACPAgent()`` builds. Only the child agent is stubbed: it records what it was
+built and run with, and persists its turn to the child's real session store.
+"""
+import json
+import threading
+from unittest.mock import MagicMock, patch
+
+import pytest
+from acp.schema import ToolCallStart
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from hermes_state import SessionDB
+from tests.acp_adapter.test_gateway_delegation_progress import (
+    editor_session, progress, registry, registry_state, run_as_tool_call,
+)
+from tools import delegate_tool_registry as reg
+from tools.delegate_tool import delegate_task
+from tools.process_registry import process_registry
+
+PARENT_SESSION = "parent-session"
+
+
+class Children:
+    """Stands in for ``AIAgent``: each child answers its last user message's ``Reply with exactly: X`` with X."""
+
+    def __init__(self):
+        self.built, self.runs = [], []
+
+    def __call__(self, **kwargs):
+        child = MagicMock()
+        child.model, child.provider, child.request_overrides = kwargs["model"], kwargs["provider"], {}
+        child.session_id = kwargs.get("session_id") or f"child-session-{len(self.built)}"
+        child._session_db, child._persist_disabled = kwargs["session_db"], False
+        child._parent_session_id = kwargs["parent_session_id"]
+        child.tool_progress_callback = kwargs["tool_progress_callback"]
+        child.get_activity_summary.return_value = {"api_call_count": 1}
+        child.session_prompt_tokens = child.session_completion_tokens = child.session_reasoning_tokens = 0
+        child.session_estimated_cost_usd = None
+
+        def run_conversation(user_message, task_id=None, stream_callback=None, conversation_history=None):
+            self.runs.append({"message": user_message, "history": conversation_history, "task_id": task_id})
+            answer = user_message.rsplit("Reply with exactly: ", 1)[-1].strip()
+            for role, content in (("user", user_message), ("assistant", answer)):
+                child._session_db.append_message(child.session_id, role, content)
+            return {"final_response": answer, "completed": True, "api_calls": 1, "messages": []}
+
+        child.run_conversation.side_effect = run_conversation
+        self.built.append(kwargs)
+        return child
+
+
+def arm(owner, tmp_path, session_id=PARENT_SESSION):
+    """Give the owner's turn a parent agent that delegates for real: its own SessionDB, the session's route."""
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id=session_id, source="tui")
+    parent = MagicMock()
+    parent.provider, parent.base_url, parent.api_key = "openrouter", "https://openrouter.ai/api/v1", "parent-key"
+    parent.api_mode, parent.model, parent.platform = "chat_completions", "test/parent-model", "local"
+    parent.request_overrides, parent.reasoning_config, parent.session_id = {}, None, session_id
+    parent.providers_allowed = parent.providers_ignored = parent.providers_order = parent.provider_sort = None
+    parent._session_db, parent._delegate_depth, parent._active_children = db, 0, []
+    parent._active_children_lock = threading.Lock()
+    parent._print_fn = parent.thinking_callback = parent._delegate_spinner = parent._subagent_id = None
+    for name in ("_tool_guardrails", "_checkpoint_mgr", "_touch_activity", "quiet_mode", "verbose_logging"):
+        setattr(parent, name, getattr(owner.parent, name))
+    parent.tool_progress_callback = owner.turn.progress_callback
+    parent.tool_start_callback = owner.turn.combined_tool_start_callback
+    owner.turn._ctx.agent_holder = [parent]
+    owner.parent = parent
+    return parent
+
+
+def call(owner, call_id, **args):
+    """One ``delegate_task`` call in its own turn of the owner's session; the turn then ends."""
+    owner.authority.executing = {"s": 1}
+    result = run_as_tool_call(owner, call_id, args, lambda: delegate_task(
+        parent_agent=owner.parent, background=True, **args))
+    owner.turn.combined_tool_complete_callback(call_id, "delegate_task", args, result)
+    owner.end_turn()
+    return json.loads(result)
+
+
+@pytest.fixture
+def children():
+    built = Children()
+    with (
+        patch("run_agent.AIAgent", side_effect=built),
+        patch("tools.delegate_tool._load_config", return_value={}),
+        # The session can receive detached results (a gateway session does): spawns run in the background.
+        patch("tools.delegate_tool_dispatch._resolve_async_wake_sid", return_value=""),
+    ):
+        yield built
+    reg._finished_subagents.clear()
+
+
+def completions():
+    events = []
+    while not process_registry.completion_queue.empty():
+        events.append(process_registry.completion_queue.get_nowait())
+    return events
+
+
+@pytest.mark.asyncio
+async def test_a_finished_child_answers_a_follow_up_on_its_own_session(tmp_path, registry, children):
+    async with editor_session() as (agent, owner, updates, settle):
+        assert type(agent) is GatewayACPAgent  # what `hermes acp` builds
+        arm(owner, tmp_path)
+        spawned = call(owner, "call_1", tasks=[{"goal": "Reply with exactly: A_FIRST"}])
+        (subagent_id,) = spawned["subagent_ids"]
+        registry.run(0)
+        listed = json.loads(delegate_task(action="list", parent_agent=owner.parent))
+        assert [(c["subagent_id"], c["resumable"]) for c in listed["finished"]] == [(subagent_id, True)]
+
+        follow_up = {"action": "continue", "subagent_id": subagent_id, "message": "Reply with exactly: A_SECOND"}
+        continued = call(owner, "call_2", **follow_up)
+        assert continued["status"] == "dispatched" and continued["subagent_ids"] == [subagent_id]
+        registry.run(1)
+        await settle()
+
+    first, second = children.built
+    assert first["session_id"] is None and second["session_id"] == "child-session-0"  # the first child's session
+    assert second["model"] == first["model"]
+    assert [run["message"] for run in children.runs] == ["Reply with exactly: A_FIRST", "Reply with exactly: A_SECOND"]
+    assert children.runs[0]["history"] is None
+    assert [(m["role"], m["content"]) for m in children.runs[1]["history"]] == [
+        ("user", "Reply with exactly: A_FIRST"), ("assistant", "A_FIRST")]
+    assert children.runs[1]["task_id"] == subagent_id  # the same terminal session as before
+    # Each answer re-enters the conversation as its own completion message.
+    assert [event["results"][0]["summary"] for event in completions()] == ["A_FIRST", "A_SECOND"]
+
+    start = next(u for u in updates if isinstance(u, ToolCallStart) and u.tool_call_id == "call_2")
+    assert start.raw_input == follow_up
+    frames = [(call_id, p["subagent_id"], p["event"], p.get("summary")) for call_id, _, p in progress(updates)]
+    assert frames == [
+        ("call_1", subagent_id, "subagent.spawn_requested", None),
+        ("call_1", subagent_id, "subagent.start", None),
+        ("call_1", subagent_id, "subagent.complete", "A_FIRST"),
+        ("call_2", subagent_id, "subagent.spawn_requested", None),
+        ("call_2", subagent_id, "subagent.start", None),
+        ("call_2", subagent_id, "subagent.complete", "A_SECOND"),
+    ]
+    # Once its follow-up is answered, the child can be continued again.
+    assert json.loads(delegate_task(action="list", parent_agent=owner.parent))["finished"][0]["subagent_id"] == subagent_id
+
+
+@pytest.mark.asyncio
+async def test_only_a_finished_child_of_this_conversation_can_be_continued(tmp_path, registry, children):
+    async with editor_session() as (_agent, owner, _updates, _settle):
+        parent = arm(owner, tmp_path)
+        (subagent_id,) = call(owner, "call_1", tasks=[{"goal": "Reply with exactly: A_FIRST"}])["subagent_ids"]
+
+        def continue_(sid=subagent_id, message="Reply with exactly: again", parent_agent=parent):
+            return json.loads(delegate_task(action="continue", subagent_id=sid, message=message,
+                                            parent_agent=parent_agent, background=True))["error"]
+
+        reg._register_subagent({"subagent_id": subagent_id, "agent": MagicMock(), "owner_agent_session_id": PARENT_SESSION})
+        assert "still running" in continue_()
+        reg._unregister_subagent(subagent_id)  # the record carries no transcript: nothing to continue
+        assert "No finished subagent" in continue_()
+        registry.run(0)  # the real child runs and finishes
+
+        assert "non-empty 'message'" in continue_(message=" ")
+        assert "No finished subagent 'sa-unknown'" in continue_(sid="sa-unknown")
+        stranger = MagicMock(session_id="another-conversation", _session_db=parent._session_db)
+        assert "No finished subagent" in continue_(parent_agent=stranger)
+        steer = json.loads(delegate_task(action="steer", subagent_id=subagent_id, message="faster", parent_agent=parent))
+        assert "already finished" in steer["error"] and "action='continue'" in steer["error"]
+
+        reg.set_spawn_paused(True)
+        try:
+            assert "paused" in continue_()  # refused before anything ran: the child stays resumable
+        finally:
+            reg.set_spawn_paused(False)
+        call(owner, "call_2", action="continue", subagent_id=subagent_id, message="Reply with exactly: A_SECOND")
+        assert "already being continued" in continue_()
+        registry.run(1)
+
+    assert [run["message"] for run in children.runs] == ["Reply with exactly: A_FIRST", "Reply with exactly: A_SECOND"]
