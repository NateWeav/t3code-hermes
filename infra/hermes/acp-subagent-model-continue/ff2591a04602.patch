@@ -0,0 +1,207 @@
+"""A ``delegate_task`` task's own ``model``, on the gateway path.
+
+A gateway session's agent runs ``delegate_task`` from its turn, and the turn publishes each child's
+``subagent.*`` frames to every viewer (``hermes acp``, the TUI, Desktop). These tests run the real call
+dispatch, ``delegate_task``, route resolution, model inventory and credential resolution against a
+temp profile, and read the frames the turn's real progress callback publishes. Only the child's
+construction and run are stubbed, where a test reads what they were handed.
+"""
+import json
+import threading
+from contextvars import Context
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import hermes_yaml as yaml
+import pytest
+
+from agent.tool_executor import _dispatch_authorized_once, _ManagedToolResult, _ToolCallRef
+from gateway.config import Platform
+from gateway.run_turn_runner import TurnRunner
+from gateway.session_authority import SessionAuthority
+from gateway.session_events import SessionEvents
+
+SID = "s"
+PROXY = "http://127.0.0.1:9/v1"
+LOCAL = "http://127.0.0.1:8/v1"
+PROFILE = {
+    "model": {"default": "claude-haiku-5-5", "provider": "custom:proxy", "base_url": PROXY},
+    "custom_providers": [
+        {"name": "proxy", "base_url": PROXY, "api_key": "proxy-key", "api_mode": "anthropic_messages",
+         "discover_models": False, "models": {"claude-haiku-5-5": {}, "claude-sonnet-5-5": {}}},
+        {"name": "local", "base_url": LOCAL, "api_key": "local-key", "api_mode": "chat_completions",
+         "discover_models": False, "models": {"qwen3-local": {}, "claude-haiku-5-5": {}}},
+    ],
+}
+
+
+@pytest.fixture
+def profile(tmp_path, monkeypatch):
+    """Write the profile's config.yaml; ``managed`` also installs a managed scope over it."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    def write(delegation=None, managed=None):
+        (home / "config.yaml").write_text(yaml.safe_dump({**PROFILE, "delegation": delegation or {}}), encoding="utf-8")
+        if managed is not None:
+            managed_dir = tmp_path / "managed"
+            managed_dir.mkdir()
+            (managed_dir / "config.yaml").write_text(yaml.safe_dump(managed), encoding="utf-8")
+            monkeypatch.setenv("HERMES_MANAGED_DIR", str(managed_dir))
+        from hermes_cli.managed_scope import invalidate_managed_cache
+        invalidate_managed_cache()
+
+    write()
+    yield write
+    from hermes_cli.managed_scope import invalidate_managed_cache
+    invalidate_managed_cache()
+
+
+class Owner:
+    """One local session's authority side: a real turn runner publishing into a real event stream."""
+
+    def __init__(self):
+        self.stream = SessionEvents()
+        self.stream.execution = {"admission_id": "a1", "execution_generation": 1}
+        live = SimpleNamespace(tool_progress_mode=None, show_reasoning=False, event_stream=self.stream)
+        self.authority = SimpleNamespace(sessions={SID: live}, executing={SID: 1})
+        self.frames = []
+        self.stream.observers.add(lambda frame: self.frames.append(frame["params"]))
+        parent = self.parent = MagicMock()
+        parent.provider, parent.requested_provider, parent.base_url = "custom", "custom:proxy", PROXY
+        parent.api_key, parent.api_mode, parent.model = "proxy-key", "anthropic_messages", "claude-haiku-5-5"
+        parent.platform, parent.request_overrides, parent.reasoning_config = "local", {}, None
+        parent.providers_allowed = parent.providers_ignored = parent.providers_order = parent.provider_sort = None
+        parent._session_db, parent._delegate_depth, parent._active_children = None, 0, []
+        parent._active_children_lock = threading.Lock()
+        parent._print_fn = parent.thinking_callback = parent._delegate_spinner = parent._subagent_id = None
+        parent._tool_guardrails = SimpleNamespace(before_call=lambda *a: SimpleNamespace(allows_execution=True))
+        parent._checkpoint_mgr = SimpleNamespace(enabled=False)
+        parent._touch_activity = lambda _: None
+        parent.quiet_mode, parent.verbose_logging = True, False
+        turn = self.turn = object.__new__(TurnRunner)
+        turn._ctx = SimpleNamespace(
+            source=SimpleNamespace(platform=Platform.LOCAL, chat_id="chat"),
+            mute_notification_reply=False, scheduled_heartbeat=False,
+            streaming_tts_consumer_holder=[None], stream_consumer_holder=[None],
+            interim_assistant_messages_enabled=False, user_config={},
+            resolve_display_setting=lambda *a: None, _run_still_current=lambda: True,
+            _voice_ack_guild=[None], _native_slack_task_cards=False, progress_mode="all",
+            session_id=SID, progress_queue=None, _live_status_adapter=None, _live_status_mode="off",
+            log_queue=None, agent_holder=[parent],
+        )
+        turn._runner = SimpleNamespace(config=None, _delivery_adapter_for=lambda source: None)
+        turn._approval_owner = (self.authority, SID, 1)
+        turn._publish_execution = lambda kind, payload: SessionAuthority.publish_execution(
+            self.authority, SID, 1, kind, payload)
+        turn._publish_api_tool = lambda *a, **k: None
+        turn._schedule = lambda coro, _message: coro.close()
+        parent.tool_progress_callback = turn.progress_callback
+        parent.tool_start_callback = turn.combined_tool_start_callback
+
+    def delegate(self, tasks):
+        """``(tool result, [AIAgent kwargs per built child])`` for one delegate_task call in this turn."""
+        built = []
+
+        def construct(**kwargs):
+            built.append(kwargs)
+            child = MagicMock()
+            child.model, child.provider, child.request_overrides = kwargs["model"], kwargs["provider"], {}
+            return child
+
+        args = {"tasks": tasks}
+        ref = _ToolCallRef("delegate_task", args, "task", "call_1", [])
+        state = _ManagedToolResult(None, args, [], False, False)
+        from tools.delegate_tool import delegate_task
+        with (
+            patch("run_agent.AIAgent", side_effect=construct),
+            patch("tools.delegate_tool._run_batch", side_effect=lambda batch, background: json.dumps(
+                {"status": "built", **({"refused": batch.refused} if batch.refused else {})})),
+        ):
+            result = Context().run(
+                _dispatch_authorized_once, self.parent, state, ref,
+                execute=lambda _: delegate_task(tasks=tasks, parent_agent=self.parent),
+                scope_block=None, display_index=None, begin_execution=None, authorization_gate=None)
+        return json.loads(result), built
+
+    def spawned_models(self):
+        return [frame["payload"].get("model") for frame in self.frames if frame["type"] == "subagent.spawn_requested"]
+
+
+def _task_model_schema():
+    from tools.delegate_tool import _build_dynamic_schema_overrides
+    overrides = _build_dynamic_schema_overrides()
+    return overrides["parameters"]["properties"]["tasks"]["items"]["properties"].get("model"), overrides["description"]
+
+
+def test_each_task_runs_on_its_model_and_the_gateway_reports_it(profile):
+    owner = Owner()
+    result, (sonnet, local, inherited) = owner.delegate([
+        {"goal": "review the routing change", "model": "claude-sonnet-5-5"},
+        {"goal": "summarize the local logs", "model": "qwen3-local"},
+        {"goal": "check the docs build"},
+    ])
+
+    assert result == {"status": "built"}
+    # The parent's own provider keeps its endpoint and key; another provider brings its own.
+    assert (sonnet["model"], sonnet["base_url"], sonnet["api_key"]) == ("claude-sonnet-5-5", PROXY, "proxy-key")
+    assert (local["model"], local["base_url"], local["api_key"]) == ("qwen3-local", LOCAL, "local-key")
+    assert local["provider"] == "custom:local"
+    assert (inherited["model"], inherited["base_url"]) == ("claude-haiku-5-5", PROXY)
+    assert owner.spawned_models() == ["claude-sonnet-5-5", "qwen3-local", "claude-haiku-5-5"]
+    schema, description = _task_model_schema()
+    assert schema["type"] == "string" and "unless a task sets `model`" in description
+    # A continue after a gateway restart re-resolves the route from its stored request: the model stays.
+    from tools.delegate_tool import _load_config
+    from tools.delegate_tool_routes import resolve_task_routes
+    (route,), _ = resolve_task_routes([{"goal": "g", "model": "qwen3-local"}], _load_config(), owner.parent)
+    (again,), _ = resolve_task_routes([{"goal": "g", **route.request}], _load_config(), owner.parent)
+    assert (again.creds["model"], again.creds["base_url"]) == ("qwen3-local", LOCAL)
+
+
+def test_a_model_the_profile_cannot_run_refuses_only_its_task(profile):
+    owner = Owner()
+    result, (qualified,) = owner.delegate([
+        {"goal": "a task on a typo", "model": "claude-sonet-5-5"},
+        {"goal": "a task on a shared id", "model": "claude-haiku-5-5"},
+        {"goal": "a task on a qualified id", "model": "custom:local:claude-haiku-5-5"},
+    ])
+
+    typo, shared = result["refused"]
+    assert typo["task_index"] == 0 and "'claude-sonet-5-5' is not a model this profile can run" in typo["error"]
+    assert "custom:proxy:claude-sonnet-5-5" in typo["error"] and "custom:local:qwen3-local" in typo["error"]
+    assert shared["task_index"] == 1 and "several providers offer 'claude-haiku-5-5'" in shared["error"]
+    assert (qualified["model"], qualified["base_url"]) == ("claude-haiku-5-5", LOCAL)
+    assert owner.spawned_models() == ["claude-haiku-5-5"]
+
+
+def test_a_managed_pin_on_the_subagent_model_wins(profile):
+    """The administrator's delegation.model is policy: the tool stops offering ``model``, and a task that names
+    one anyway is refused rather than routed around the pin."""
+    profile(managed={"delegation": {"model": "claude-sonnet-5-5"}})
+    owner = Owner()
+
+    schema, description = _task_model_schema()
+    assert schema is None and "unless a task sets `model`" not in description
+    result, (pinned,) = owner.delegate([
+        {"goal": "a task naming its own model", "model": "qwen3-local"},
+        {"goal": "a task taking the default"},
+    ])
+
+    (refused,) = result["refused"]
+    assert refused["task_index"] == 0 and "delegation.model in the managed config" in refused["error"]
+    assert (pinned["model"], pinned["base_url"]) == ("claude-sonnet-5-5", PROXY)
+    assert owner.spawned_models() == ["claude-sonnet-5-5"]
+
+
+def test_a_user_set_delegation_model_is_only_the_default(profile):
+    profile(delegation={"model": "claude-sonnet-5-5"})
+    owner = Owner()
+    _, (chosen, default) = owner.delegate([
+        {"goal": "a task naming its own model", "model": "qwen3-local"},
+        {"goal": "a task taking the default"},
+    ])
+
+    assert (chosen["model"], chosen["base_url"]) == ("qwen3-local", LOCAL)
+    assert (default["model"], default["base_url"]) == ("claude-sonnet-5-5", PROXY)
