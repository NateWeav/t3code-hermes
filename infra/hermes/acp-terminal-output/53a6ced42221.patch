new file mode 100644
index 0000000000..bae45a4086
--- /dev/null
+++ b/acp_adapter/terminal_output.py
@@ -0,0 +1,69 @@
+"""A running ``terminal`` call's output as the editor's display-only terminal.
+
+ACP v1 has no update that appends to a tool call: ``content`` replaces the card's content, so streaming
+through it would resend the whole output with each piece. Editors that render a terminal from tool-call
+``_meta`` advertise ``clientCapabilities._meta.terminal_output: true`` (Zed, T3 Code), and codex-acp and
+claude-agent-acp then use ``terminal_info``, ``terminal_output`` and ``terminal_exit``. Hermes does the same
+with the gateway's ``tool.output`` frames. The call's ``tool.complete`` update still sends its result as
+content, so a client without the capability sees no change.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+import acp
+
+
+def client_renders_terminal_output(initialize_params: Any) -> bool:
+    """``clientCapabilities._meta.terminal_output`` is true, read from the raw initialize params
+    (the pinned SDK's ``ClientCapabilities`` keeps no ``_meta``)."""
+    capabilities = initialize_params.get("clientCapabilities") if isinstance(initialize_params, dict) else None
+    meta = capabilities.get("_meta") if isinstance(capabilities, dict) else None
+    return isinstance(meta, dict) and meta.get("terminal_output") is True
+
+
+async def project_tool_output(agent, sid, editor_id, payload) -> None:
+    """One ``tool.output`` frame as a ``tool_call_update`` carrying only ``_meta.terminal_output``.
+
+    Before a call's first one, the call is announced again (``tool_call``, which editors upsert) with a
+    ``terminal`` content block and ``terminal_info``: Zed creates the terminal only from a ``tool_call``,
+    and only calls that print anything get one. Frames for a call the editor no longer shows open are
+    dropped."""
+    key = (sid, payload.get("tool_id"))
+    text = payload.get("text")
+    if not agent._terminal_output or key not in agent._tool_args or not isinstance(text, str) or not text \
+            or not agent._conn:
+        return
+    call_id = key[1]
+    if key not in agent._live_terminals:
+        from acp_adapter.tools import build_tool_start
+        agent._live_terminals.intersection_update(agent._tool_args)
+        agent._live_terminals.add(key)
+        tool_name, args, _ = agent._tool_args[key]
+        opened = build_tool_start(call_id, tool_name, args)
+        opened.status = "in_progress"
+        opened.content = [acp.tool_terminal_ref(call_id)]
+        opened.field_meta = {"terminal_info": {"terminal_id": call_id}}
+        await agent._conn.session_update(session_id=editor_id, update=opened)
+    update = acp.update_tool_call(call_id)
+    update.field_meta = {"terminal_output": {"terminal_id": call_id, "data": text}}
+    await agent._conn.session_update(session_id=editor_id, update=update)
+
+
+async def close_tool_terminal(agent, sid, editor_id, payload) -> None:
+    """Before a call's ``tool.complete`` replaces its card: ``terminal_exit`` for the terminal it opened."""
+    key = (sid, payload.get("tool_call_id"))
+    if key not in agent._live_terminals:
+        return
+    agent._live_terminals.discard(key)
+    try:
+        exit_code = json.loads(payload.get("result") or "").get("exit_code")
+    except (TypeError, ValueError, AttributeError):
+        exit_code = None
+    if agent._conn:
+        update = acp.update_tool_call(key[1])
+        update.field_meta = {"terminal_exit": {
+            "terminal_id": key[1], "exit_code": exit_code if isinstance(exit_code, int) else None, "signal": None}}
+        await agent._conn.session_update(session_id=editor_id, update=update)
