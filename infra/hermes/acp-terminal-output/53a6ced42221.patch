diff --git a/agent/tool_progress_relay.py b/agent/tool_progress_relay.py
index a7f24f7dd8..df250e3c3d 100644
--- a/agent/tool_progress_relay.py
+++ b/agent/tool_progress_relay.py
@@ -66,3 +66,40 @@ def tool_progress_payload(name: Optional[str], message: Optional[str], kwargs: d
     return {"tool_id": str(kwargs.get("tool_call_id") or ""), "name": str(name or ""),
             "progress": float(kwargs.get("progress") or 0.0), "total": kwargs.get("total"),
             "percent": kwargs.get("percent"), "message": str(message) if message else None}
+
+
+TOOL_OUTPUT_EVENT = "tool.output"
+
+OutputReporter = Callable[[str], None]
+_output: contextvars.ContextVar[Optional[OutputReporter]] = contextvars.ContextVar("tool_output_reporter", default=None)
+
+
+def _output_reporter(callback, tool_name: str, tool_call_id: str) -> OutputReporter:
+    def report(text: str) -> None:
+        try:
+            callback(TOOL_OUTPUT_EVENT, tool_name, None, None, tool_call_id=tool_call_id, text=text)
+        except Exception:  # health: allow BLE001 -- a UI sink failing must never fail the tool call
+            logger.debug("tool.output callback failed for %s", tool_name, exc_info=True)
+    return report
+
+
+@contextlib.contextmanager
+def bound_tool_output(callback, tool_name: str, tool_call_id: str) -> Iterator[None]:
+    """Bind this call's live-output sink for the block (no-op when the agent has no progress callback).
+    The tool decides what to send and how often: ``tools/environments/live_output.py`` for ``terminal``."""
+    token = _output.set(_output_reporter(callback, tool_name, tool_call_id or "") if callback else None)
+    try:
+        yield
+    finally:
+        _output.reset(token)
+
+
+def current_tool_output() -> Optional[OutputReporter]:
+    """The running call's live-output sink (display only, never the model's result), or None."""
+    return _output.get()
+
+
+def tool_output_payload(name: Optional[str], kwargs: dict) -> dict:
+    """The ``tool.output`` wire payload: the next piece of a running call's output, in order."""
+    return {"tool_id": str(kwargs.get("tool_call_id") or ""), "name": str(name or ""),
+            "text": str(kwargs.get("text") or "")}
