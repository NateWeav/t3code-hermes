diff --git a/tests/acp_adapter/test_gateway_terminal_output.py b/tests/acp_adapter/test_gateway_terminal_output.py
new file mode 100644
index 0000000000..b7954776c1
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_terminal_output.py
@@ -0,0 +1,151 @@
+"""A foreground ``terminal`` command's output reaches an editor while it runs.
+
+The real terminal tool runs a real shell command through the local backend; its live output goes
+through the bound ``tool.output`` sink, the gateway turn's progress callback and the viewer stream
+into ``GatewayACPAgent``, which projects it as ``_meta.terminal_output`` for an editor that renders
+it (Zed, T3 Code)."""
+from __future__ import annotations
+
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+import tools.terminal_tool as terminal_tool_module
+from acp_adapter.gateway_server import GatewayACPAgent
+from agent.tool_progress_relay import bound_tool_output
+from gateway.config import Platform
+from gateway.run_turn_runner import TurnRunner
+from tools.ansi_strip import strip_ansi
+from tools.environments.live_output import LiveOutput
+from tools.environments.local import LocalEnvironment
+
+TOKEN = "ghp_" + "A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8"
+
+
+def _turn(published, first_output):
+    """A LOCAL (ACP-created) session's turn whose viewer frames land in *published*."""
+    def publish(kind, payload):
+        published.append((kind, payload))
+        if kind == "tool.output":
+            first_output.set()
+        return True
+
+    turn = object.__new__(TurnRunner)
+    turn._ctx = SimpleNamespace(source=SimpleNamespace(platform=Platform.LOCAL, chat_id="chat"),
+                                progress_queue=None, _live_status_adapter=None, log_queue=None)
+    turn._approval_owner = (SimpleNamespace(sessions={"s": SimpleNamespace(tool_progress_mode=None)}), "s", 1)
+    turn._publish_execution = publish
+    return turn
+
+
+def _editor(*, terminal_output):
+    editor = GatewayACPAgent()
+    editor._snapshots["s"] = {}
+    editor._gateway = AsyncMock()
+    editor._conn = AsyncMock()
+    capabilities = {"_meta": {"terminal_output": True}} if terminal_output else {}
+    editor._observe_client_message(SimpleNamespace(direction="incoming", message={
+        "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": capabilities}}))
+    return editor
+
+
+def _updates(editor):
+    return [call.kwargs["update"] for call in editor._conn.session_update.await_args_list]
+
+
+async def _project(editor, kind, payload):
+    await editor._project({"session_id": "s", "type": kind, "admission_id": "a", "payload": payload})
+
+
+@pytest.fixture
+def terminal(monkeypatch, tmp_path):
+    env = LocalEnvironment(cwd=str(tmp_path))
+    monkeypatch.setattr(terminal_tool_module, "_get_env_config", lambda: {
+        "env_type": "local", "timeout": 60, "cwd": str(tmp_path), "host_cwd": None, "modal_mode": "auto",
+        "docker_image": "", "modal_image": "", "daytona_image": ""})
+    monkeypatch.setattr(terminal_tool_module, "_start_cleanup_thread", lambda: None)
+    monkeypatch.setattr(terminal_tool_module, "_check_all_guards", lambda *_a, **_k: {"approved": True})
+    monkeypatch.setitem(terminal_tool_module._active_environments, "default", env)
+    monkeypatch.setitem(terminal_tool_module._last_activity, "default", 0.0)
+    try:
+        yield tmp_path
+    finally:
+        env.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_running_command_streams_its_output_to_an_editor_that_renders_it(terminal):
+    # The command holds after its first line until the test has seen that line arrive.
+    command = ("printf '\\033[32mline 1\\033[0m\\n'; while [ ! -e go ]; do sleep 0.05; done; "
+               f"echo token={TOKEN}; printf 'progress 50%%\\rprogress 100%%\\n'")
+    published, first_output, result = [], threading.Event(), {}
+    turn = _turn(published, first_output)
+
+    def run():
+        with bound_tool_output(turn.progress_callback, "terminal", "c1"):
+            result.update(json.loads(terminal_tool_module.terminal_tool(command=command)))
+
+    worker = threading.Thread(target=run)
+    worker.start()
+    streamed_while_running = first_output.wait(30)
+    (terminal / "go").touch()
+    worker.join(30)
+    assert streamed_while_running and not worker.is_alive()
+
+    frames = [payload for kind, payload in published if kind == "tool.output"]
+    assert {(frame["tool_id"], frame["name"]) for frame in frames} == {("c1", "terminal")}
+    live = "".join(frame["text"] for frame in frames)
+    assert frames[0]["text"] == "\x1b[32mline 1\x1b[0m"
+    assert "progress 50%\rprogress 100%" in live
+    assert TOKEN not in live and TOKEN not in result["output"]
+    assert "__HERMES_" not in live
+    # The model's result is unchanged, and it is what the viewer was shown, without colour.
+    assert "\x1b" not in result["output"] and result["exit_code"] == 0
+    assert strip_ansi(live).strip() == result["output"]
+
+    editor = _editor(terminal_output=True)
+    start = {"tool_call_id": "c1", "tool_name": "terminal", "args": {"command": command}}
+    await _project(editor, "tool.start", start)
+    for frame in frames:
+        await _project(editor, "tool.output", frame)
+    await _project(editor, "tool.complete", {**start, "is_error": False, "result": json.dumps(result)})
+    started, opened, *streamed, exited, completed = _updates(editor)
+    # Zed creates the display terminal only from a ``tool_call``, which it upserts onto the started call.
+    assert (opened.session_update, opened.tool_call_id, opened.title, opened.status) == (
+        "tool_call", "c1", started.title, "in_progress")
+    assert [block.terminal_id for block in opened.content] == ["c1"]
+    assert opened.field_meta == {"terminal_info": {"terminal_id": "c1"}}
+    assert all(update.content is None and set(update.field_meta) == {"terminal_output"} for update in streamed)
+    assert "".join(update.field_meta["terminal_output"]["data"] for update in streamed) == live
+    assert exited.field_meta == {"terminal_exit": {"terminal_id": "c1", "exit_code": 0, "signal": None}}
+    assert completed.status == "completed" and completed.field_meta is None
+
+
+@pytest.mark.asyncio
+async def test_output_reaches_only_an_editor_that_renders_it_and_only_while_the_call_is_open():
+    start = {"tool_call_id": "c1", "tool_name": "terminal", "args": {"command": "make"}}
+    output = {"tool_id": "c1", "name": "terminal", "text": "building"}
+    plain = _editor(terminal_output=False)
+    await _project(plain, "tool.start", start)
+    await _project(plain, "tool.output", output)
+    assert len(_updates(plain)) == 1
+
+    editor = _editor(terminal_output=True)
+    await _project(editor, "tool.start", start)
+    await _project(editor, "tool.complete", {**start, "is_error": False, "result": '{"output": "", "exit_code": 0}'})
+    await _project(editor, "tool.output", output)
+    assert [update.field_meta for update in _updates(editor)] == [None, None]
+
+
+def test_output_from_a_private_key_onward_is_never_streamed():
+    """A key spans lines, so a batch boundary could split it past the redaction pattern."""
+    sent = []
+    live = LiveOutput(sent.append, "cat id_rsa", ())
+    live.feed("before\n-----BEGIN OPENSSH PRIVATE")
+    live.flush()
+    live.feed(" KEY-----\nb3BlbnNzaC1rZXktdjEAAAAA\n-----END OPENSSH PRIVATE KEY-----\nafter\n")
+    live.flush(final=True)
+    assert sent == ["before"]
