diff --git a/tools/environments/live_output.py b/tools/environments/live_output.py
new file mode 100644
index 0000000000..c764f26647
--- /dev/null
+++ b/tools/environments/live_output.py
@@ -0,0 +1,99 @@
+"""A foreground command's output while it runs, for the viewers of its ``terminal`` call.
+
+Display only: the model still gets ``finalize_foreground_result``'s output, which also replaces what the
+viewer was shown when the call completes. Each batch gets the same secret redaction as that result, holds
+whole lines (``\\n`` or ``\\r``), and goes out at most every ``_FLUSH_INTERVAL_S``.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from typing import Callable, Iterable, Optional
+
+_FLUSH_INTERVAL_S = 0.25
+# A flood keeps only its newest lines per batch: viewers show a tail, and every batch lands in the
+# session's bounded replay ring.
+_MAX_BATCH_CHARS = 8 * 1024
+# A private key spans lines, so a batch boundary could split it past the redaction pattern.
+_KEY_MARKER = "PRIVATE KEY-----"
+
+
+class LiveOutput:
+    def __init__(self, emit: Callable[[str], None], command: str, markers: Iterable[str]):
+        self._emit = emit
+        self._command = command
+        # The shell wrapper's cwd/pipe-status lines, printed after the command; the result strips them.
+        self._markers = tuple(marker for marker in markers if marker)
+        self._lock = threading.Lock()
+        self._chunks: list[str] = []
+        self._chars = 0
+        self._scan_tail = ""
+        self._last = 0.0
+        self._done = False
+
+    def feed(self, text: str) -> None:
+        """The drain thread's next decoded chunk."""
+        with self._lock:
+            if self._done:
+                return
+            scanned = self._scan_tail + text
+            if _KEY_MARKER in scanned:
+                self._stop()
+                return
+            self._scan_tail = scanned[-len(_KEY_MARKER):]
+            self._chunks.append(text)
+            self._chars += len(text)
+            while self._chars > 4 * _MAX_BATCH_CHARS and len(self._chunks) > 1:
+                self._chars -= len(self._chunks.pop(0))
+
+    def flush(self, *, final: bool = False) -> None:
+        """Send what arrived since the last batch; ``final`` once the process has exited."""
+        now = time.monotonic()
+        with self._lock:
+            if self._done or not self._chunks or (not final and now - self._last < _FLUSH_INTERVAL_S):
+                return
+            text = "".join(self._chunks)
+            cut = min((at for marker in self._markers if (at := text.find(marker)) != -1), default=-1)
+            if cut != -1:
+                # The wrapper starts each marker line with its own newline.
+                text = text[:cut].removesuffix("\n")
+                self._stop()
+            elif final:
+                self._stop()
+            else:
+                # Hold the last line break back with the partial line after it: it may be the wrapper's.
+                end = max(text.rfind("\n"), text.rfind("\r"))
+                if end <= 0:
+                    return
+                self._chunks, self._chars = [text[end:]], len(text) - end
+                text = text[:end]
+            self._last = now
+        if len(text) > _MAX_BATCH_CHARS:
+            text = text[-_MAX_BATCH_CHARS:]
+            text = text[max(text.find("\n"), 0):]
+        if text:
+            self._emit(_redacted(text, self._command))
+
+    def _stop(self) -> None:
+        self._done = True
+        self._chunks, self._chars = [], 0
+
+
+def _redacted(text: str, command: str) -> str:
+    """The result's redaction (``finalize_foreground_result``), keeping colour unless an escape
+    sequence split a secret the plain text shows."""
+    from agent.redact import redact_terminal_output
+    from tools.ansi_strip import strip_ansi
+    shown = redact_terminal_output(text, command)
+    if "\x1b" not in text:
+        return shown
+    plain = redact_terminal_output(strip_ansi(text), command)
+    return shown if strip_ansi(shown) == plain else plain
+
+
+def live_output_for(command: str, markers: Iterable[str]) -> Optional[LiveOutput]:
+    """A ``LiveOutput`` for the running tool call's viewers, or None when nothing listens."""
+    from agent.tool_progress_relay import current_tool_output
+    emit = current_tool_output()
+    return None if emit is None else LiveOutput(emit, command, markers)
