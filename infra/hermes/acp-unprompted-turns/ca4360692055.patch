+    def _unprompted(self, event):
+        """A frame of a turn this editor did not submit: a gateway wake, or another surface's input."""
+        sid, aid = event.get("session_id"), event.get("admission_id")
+        # Session events carry the running turn's stamp too, but belong to no turn.
+        if aid is None or str(event.get("type")).startswith("session.") or (sid, aid) in self._inflight:
+            return False
+        # Before its receipt, an admission is ours by the input_id its pending row (published at
+        # admission, ahead of its ``message.start``) names.
+        return not any(row.get("admission_id") == aid and row.get("input_id") in self._submitted_inputs
+                       for row in self._snapshots.get(sid, {}).get("pending", []))
