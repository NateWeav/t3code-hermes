diff --git a/tests/acp_adapter/test_gateway_unprompted_turn.py b/tests/acp_adapter/test_gateway_unprompted_turn.py
new file mode 100644
index 0000000000..b77130cf77
--- /dev/null
+++ b/tests/acp_adapter/test_gateway_unprompted_turn.py
@@ -0,0 +1,105 @@
+"""A turn the editor did not submit reaches it stamped ``_meta.hermes.unprompted``. The gateway runs a
+wake (a stopped or finished background job handed back) ahead of a prompt queued behind it, so the
+wake streams while that prompt is open, and the stamp is all that separates the two turns."""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import acp
+import pytest
+
+from acp_adapter.gateway_server import GatewayACPAgent
+from tests.waiting import async_wait_until
+
+
+class Gateway:
+    """The gateway client the viewer reads: its ordered event stream and ``prompt.submit``."""
+
+    def __init__(self):
+        self.events = asyncio.Queue()
+        self.seq = 0
+        self.on_submit = None
+
+    def publish(self, kind, payload, admission_id=None):
+        # Every frame carries the running turn's stamp, session events included.
+        self.seq += 1
+        params = {'session_id': 's', 'type': kind, 'payload': payload, 'replay_epoch': 'e', 'seq': self.seq}
+        if admission_id is not None:
+            params['admission_id'] = admission_id
+        self.events.put_nowait({'params': params})
+
+    def turn(self, admission_id, reply):
+        self.publish('message.start', {}, admission_id)
+        self.publish('message.delta', {'text': reply}, admission_id)
+        self.publish('session.usage', {'context_length': 200000, 'context_tokens': 1200}, admission_id)
+        self.publish('message.complete', {'text': reply, 'outcome': 'completed'}, admission_id)
+
+    async def rpc(self, method, **params):
+        assert method == 'prompt.submit', method
+        return await self.on_submit(params)
+
+
+async def connected():
+    # ``hermes acp`` builds the agent with no arguments, then the ACP SDK connects it.
+    agent = GatewayACPAgent()
+    conn = SimpleNamespace(session_update=AsyncMock())
+    agent.on_connect(conn)
+    gateway = Gateway()
+    agent._snapshots['s'] = {}
+    agent._gateway = gateway
+    agent._event_task = asyncio.create_task(agent._events())
+    return agent, gateway, conn
+
+
+def sent(conn):
+    """(kind, text, unprompted) of each update the editor received."""
+    return [(call.kwargs['update'].session_update, getattr(getattr(call.kwargs['update'], 'content', None), 'text', None),
+             call.kwargs.get('hermes', {}).get('unprompted', False))
+            for call in conn.session_update.await_args_list]
+
+
+@pytest.mark.asyncio
+async def test_a_wake_run_ahead_of_a_queued_prompt_is_stamped_and_the_prompts_turn_is_not():
+    agent, gateway, conn = await connected()
+
+    async def submit(params):
+        # The wake was admitted first: the editor's input queues behind it.
+        gateway.publish('session.info', {'pending': [
+            {'admission_id': 'wake', 'status': 'started', 'input_id': 'notification'},
+            {'admission_id': 'ours', 'status': 'queued', 'input_id': params['input_id']}]}, 'wake')
+        return {'admission_id': 'ours', 'status': 'queued'}
+
+    gateway.on_submit = submit
+    prompted = asyncio.create_task(agent.prompt([acp.text_block('Reply with exactly: RESUMED')], 's'))
+    await async_wait_until(lambda: ('s', 'ours') in agent._inflight)
+    gateway.turn('wake', 'Agent B was stopped.')
+    gateway.turn('ours', 'RESUMED')
+    assert (await asyncio.wait_for(prompted, 5)).stop_reason == 'end_turn'
+    agent._event_task.cancel()
+    assert sent(conn) == [
+        ('agent_message_chunk', 'Agent B was stopped.', True),
+        # Usage belongs to the session, not to the turn that happened to be running.
+        ('usage_update', None, False),
+        ('agent_message_chunk', 'RESUMED', False),
+        ('usage_update', None, False),
+    ]
+
+
+@pytest.mark.asyncio
+async def test_the_prompts_own_turn_is_not_stamped_when_it_streams_before_the_receipt():
+    agent, gateway, conn = await connected()
+
+    async def submit(params):
+        # Admission publishes the row before its turn can start; the ack can trail the whole turn.
+        gateway.publish('session.info', {'pending': [
+            {'admission_id': 'ours', 'status': 'queued', 'input_id': params['input_id']}]})
+        gateway.turn('ours', 'RESUMED')
+        await async_wait_until(lambda: 'ours' in agent._terminals)
+        return {'admission_id': 'ours', 'status': 'queued'}
+
+    gateway.on_submit = submit
+    response = await asyncio.wait_for(agent.prompt([acp.text_block('Reply with exactly: RESUMED')], 's'), 5)
+    agent._event_task.cancel()
+    assert response.stop_reason == 'end_turn'
+    assert [(kind, text, unprompted) for kind, text, unprompted in sent(conn) if text] == [
+        ('agent_message_chunk', 'RESUMED', False)]
