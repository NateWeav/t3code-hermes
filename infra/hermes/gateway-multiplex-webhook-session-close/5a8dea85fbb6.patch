From b44d8bedb0c1e5617ca146d0841a0ea835b7d8b1 Mon Sep 17 00:00:00 2001
From: "T3 Code (Hermes fork)" <t3code@users.noreply.github.com>
Date: Thu, 1 Oct 2026 15:02:29 +0000
Subject: [PATCH] gateway: close multiplexed profile webhook sessions in the
 profile's store

On a multiplexed gateway, a webhook run served under /p/<profile>/ writes
its session row to profiles/<profile>/state.db, because the inbound path
runs inside that profile's runtime scope. on_processing_complete fires
outside that scope, so _end_webhook_session ended the session through
runner._session_db, the launch home's store, which has no such row. The
update matched nothing, ended_at stayed NULL, and prune_sessions never
reaps the row.

When the session key belongs to a named profile, close the session in the
store SessionStore._db_for_key resolves for that key. Single-profile
gateways and default-profile keys keep using runner._session_db.
---
 gateway/platforms/webhook.py                |  5 ++
 tests/gateway/test_webhook_session_close.py | 56 +++++++++++++++++++++
 2 files changed, 61 insertions(+)

diff --git a/gateway/platforms/webhook.py b/gateway/platforms/webhook.py
index 1aab5959a4..f983992bf6 100644
--- a/gateway/platforms/webhook.py
+++ b/gateway/platforms/webhook.py
@@ -693,6 +693,11 @@ class WebhookAdapter(BasePlatformAdapter):
             if not session_id:
                 logger.debug("[webhook] No session_id to close for %s (key=%s)", session_chat_id, session_key)
                 return
+            # Multiplexed: a named profile's row lives in its own state.db, but this hook runs outside the
+            # profile scope, where ``_session_db`` is the launch home's store. Close it where the key says.
+            if callable(owner := getattr(store, "_named_profile_for_key", None)) and owner(session_key):
+                from hermes_state import AsyncSessionDB
+                session_db = AsyncSessionDB(store._db_for_key(session_key))
             # AsyncSessionDB forwards end_session via to_thread; plain SessionDB is sync.
             result = session_db.end_session(session_id, "webhook_complete")
             if asyncio.iscoroutine(result):
diff --git a/tests/gateway/test_webhook_session_close.py b/tests/gateway/test_webhook_session_close.py
index 9901a1bb74..9af8f44f5a 100644
--- a/tests/gateway/test_webhook_session_close.py
+++ b/tests/gateway/test_webhook_session_close.py
@@ -151,3 +151,59 @@ async def test_completed_webhook_delivery_closes_its_session(tmp_path):
     store._db.close()
 
 
+@pytest.mark.asyncio
+async def test_multiplexed_profile_webhook_closes_session_in_profile_store(tmp_path, monkeypatch):
+    """A ``/p/<profile>/`` delivery on a multiplexed gateway closes the row in THAT profile's state.db.
+
+    The run writes its row under ``profiles/<name>/state.db`` (the inbound path is profile-scoped), but
+    completion fires unscoped, where ``runner._session_db`` is the launch home's store. Ending the session
+    there updates nothing and the row stays open forever.
+    """
+    import hermes_state
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from hermes_state import AsyncSessionDB, SessionDB
+
+    root = tmp_path / "hermes"
+    profile_home = root / "profiles" / "upstream-sync"
+    profile_home.mkdir(parents=True)
+    (profile_home / "config.yaml").write_text("{}\n", encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    # Let ``_default_db_path()`` follow the profile scope instead of the suite's pinned test DB.
+    monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", hermes_state._IMPORT_DEFAULT_DB_PATH)
+
+    (root / "sessions").mkdir()
+    config = GatewayConfig(platforms={Platform.WEBHOOK: PlatformConfig(enabled=True)}, multiplex_profiles=True)
+    store = SessionStore(sessions_dir=root / "sessions", config=config)
+    runner = _FakeRunner(store)
+    runner._session_db = AsyncSessionDB(store._db)  # unscoped: the launch home's store, as in the live gateway
+
+    adapter = _make_adapter({"alerts": {"secret": _INSECURE_NO_AUTH, "prompt": "{message}"}})
+    adapter.gateway_runner = runner
+    created = {}
+
+    async def _message_handler(event: MessageEvent):
+        token = set_hermes_home_override(str(profile_home))  # what ``_profile_runtime_scope`` installs
+        try:
+            created["session_id"] = store.get_or_create_session(event.source).session_id
+        finally:
+            reset_hermes_home_override(token)
+        return ""
+
+    adapter._message_handler = _message_handler
+    event = _make_event(adapter, "alert-close-002", "Alert: merge conflict")
+    event.source.profile = "upstream-sync"  # what ``_spawn_agent_run`` sets for a ``/p/<profile>/`` route
+
+    await adapter.handle_message(event)
+    await _drain_background_tasks(adapter)
+
+    assert runner._session_key_for_source(event.source).startswith("agent:upstream-sync:")
+    profile_db = SessionDB(profile_home / "state.db")
+    try:
+        row = profile_db.get_session(created["session_id"])
+        assert row is not None, "the run's row must live in the profile's store"
+        assert row["ended_at"] is not None, "profile webhook session was never closed"
+        assert row["end_reason"] == "webhook_complete"
+    finally:
+        profile_db.close()
+
+
