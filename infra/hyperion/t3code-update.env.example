# Copy to ~/.config/t3code-update.env and edit.
#
# Read by both t3code-update.sh (sourced) and t3code-update.service
# (EnvironmentFile), so keep it to plain KEY=value lines:
#   - full-line comments only, no trailing comments
#   - no shell expansion ($HOME, ~ and backticks are NOT expanded by systemd)
#   - no `export`
#
# Everything here is optional; the script's built-in defaults are shown.

# The fork. NEVER point this at pingdotgg/t3code — that drops the Hermes driver.
T3CODE_REPO_URL=https://github.com/NateWeav/t3code-hermes.git
T3CODE_BRANCH=main

# Absolute path (no ~). The checkout the t3code.service unit runs from.
#T3CODE_DIR=/home/ubuntu/t3code
#T3CODE_SERVICE=t3code.service

# Health check target. Left unset, both are parsed out of the server unit's
# ExecStart (--host/--port), which is why the tailnet IP is not in the repo.
#T3CODE_HEALTH_HOST=100.x.y.z
#T3CODE_HEALTH_PORT=8790
#T3CODE_HEALTH_PATH=/
#T3CODE_HEALTH_TIMEOUT_SECONDS=150

# V8 heap cap for `pnpm --filter @t3tools/web build`. The server is stopped
# before the build runs, but hyperion has no swap — lower this (2048, 1792) if
# the build gets OOM-killed, raise it if the build dies with "heap out of memory".
#T3CODE_BUILD_HEAP_MB=2560

# Set to 1 to let the updater discard uncommitted changes to tracked files
# instead of refusing to run.
#T3CODE_DISCARD_LOCAL_CHANGES=0
