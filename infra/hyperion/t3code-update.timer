; systemd USER unit — install at ~/.config/systemd/user/t3code-update.timer
;
;   systemctl --user daemon-reload
;   systemctl --user enable --now t3code-update.timer
;   systemctl --user list-timers t3code-update.timer
;
; Requires lingering (`sudo loginctl enable-linger $USER`) to fire while logged out.

[Unit]
Description=Nightly self-update for the T3 Code server (Hermes fork)
Documentation=file:%h/t3code/infra/hyperion/README.md

[Timer]
Unit=t3code-update.service
OnBootSec=2m
OnUnitInactiveSec=5m
RandomizedDelaySec=30s
AccuracySec=10s

[Install]
WantedBy=timers.target
